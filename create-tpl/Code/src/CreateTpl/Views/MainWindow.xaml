<Window x:Class="CreateTpl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="http://handyorg.github.io/handycontrol"
        xmlns:hcc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:helpers="clr-namespace:CreateTpl.Helpers"
        Title="create-tpl · Blueprint Studio"
        Width="1360" Height="860" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Icon="pack://application:,,,/CreateTpl;component/Assets/app.ico"
        Background="{DynamicResource BgVoidBrush}">

    <Window.Resources>
        <!-- ═══ 转换器 ═══ -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- ═══ 效果资源 ═══ -->
        <BlurEffect x:Key="BlobBlurLarge" Radius="80" />
        <BlurEffect x:Key="BlobBlurExtra" Radius="100" />
        <DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="36" ShadowDepth="8" Opacity="0.4" />
        <DropShadowEffect x:Key="GemGlow" Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.4" />

        <!-- ═══ 玻璃面板 ═══ -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Effect" Value="{StaticResource PanelShadow}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 面板标题行 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelTitleIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSubBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 无边框裸输入框（胶囊 / 代码编辑器内嵌） -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AuroraEmeraldBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- 玻璃按钮（重置 / 定位目录 / 主题切换） -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StatusPillBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlassHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 脉冲流光主按钮（启动蓝图构建） -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="4" Opacity="0.35" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBtnGradientHover}" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#10B981" BlurRadius="28" ShadowDepth="6" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径胶囊容器：聚焦时青色描边辉光 -->
        <Style x:Key="CapsuleBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CapsuleBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AuroraCyanBrush}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#06B6D4" BlurRadius="12" ShadowDepth="0" Opacity="0.2" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 可折叠拓扑树（需求 3.5：文件夹层级可展开/收起） ═══ -->
        <Style x:Key="TopologyTree" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TopologyItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border Background="{DynamicResource NodeBgBrush}" CornerRadius="8"
                                    Padding="8,7" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 折叠开关：整块 18×18 可点击（含透明命中区），展开时箭头旋转 -->
                                    <ToggleButton x:Name="Expander"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Width="18" Height="18" Margin="0,0,2,0"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" Cursor="Hand"
                                                  ToolTip="展开 / 收起">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Chev" Data="M9,6 L15,12 L9,18"
                                                          Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Stretch="Uniform" Width="10"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chev" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="22,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 占位提示文本 -->
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible" />
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Growl 消息容器 -->
    <Grid hcc:Growl.GrowlParent="True">

        <!-- ═══ 氛围背景层：极光光晕 + 蓝图网格（不可交互） ═══ -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Fill="{DynamicResource BlobEmeraldBrush}" Width="620" Height="520"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,-100,0,0"
                     Effect="{StaticResource BlobBlurLarge}" />
            <Ellipse Fill="{DynamicResource BlobIndigoBrush}" Width="720" Height="620"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,-100"
                     Effect="{StaticResource BlobBlurExtra}" />
            <Rectangle Fill="{DynamicResource MeshBrush}" />
        </Grid>

        <!-- ═══ 内容层 ═══ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ─────── 顶部玻璃导航栏 ─────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="32,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌区 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Effect="{StaticResource GemGlow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0" />
                                    <GradientStop Color="#06B6D4" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M12,2 L22,7 L12,12 L2,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                                  Stroke="{DynamicResource GemIconStrokeBrush}" StrokeThickness="2"
                                  StrokeMiterLimit="1" Stretch="Uniform" Margin="6" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CREATE-TPL" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextGlowBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource TagEmeraldBgBrush}"
                                        BorderBrush="{DynamicResource AuroraCyanBrush}" BorderThickness="1"
                                        CornerRadius="20" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="STUDIO" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AuroraCyanBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="现代工程骨架架构师 · 标准化初始化引擎"
                                       FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 主题切换（昼 / 夜） -->
                    <Button Grid.Column="2" Style="{StaticResource GlassButton}"
                            Width="36" Height="36"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="切换昼间 / 夜间主题" Margin="0,0,16,0">
                        <Grid>
                            <!-- 月亮（暗色主题时显示，点击切到亮色） -->
                            <Path Data="M21,12.79 A9,9 0 1 1 11.21,3 A7,7 0 0 0 21,12.79 Z"
                                  Fill="{DynamicResource AuroraCyanBrush}" Stretch="Uniform" Width="15"
                                  Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}" />
                            <!-- 太阳（亮色主题时显示） -->
                            <Path Data="M12,4 V2 M12,22 V20 M4.93,4.93 L6.34,6.34 M17.66,17.66 L19.07,19.07 M2,12 H4 M20,12 H22 M4.93,19.07 L6.34,17.66 M17.66,6.34 L19.07,4.93 M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8"
                                  Stroke="{DynamicResource AuroraEmeraldBrush}" StrokeThickness="1.8"
                                  Stretch="Uniform" Width="16"
                                  Visibility="{Binding IsDarkTheme, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Button>

                    <!-- 引擎状态胶囊 -->
                    <Border Grid.Column="3" Background="{DynamicResource StatusPillBgBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AuroraEmeraldBrush}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineStatusText}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ─────── 三阶全景工作台 ─────── -->
            <Grid Grid.Row="1" Margin="32,24,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- ═══ 舞台 1：蓝图源定义 ═══ -->
                <Border Grid.Column="0" Style="{StaticResource GlassPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 面板头 -->
                        <Border Grid.Row="0" Padding="22,18" BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="15,15,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource PanelTitleIcon}"
                                      Data="M19.4,15 A1.65,1.65 0 0 0 19.73,16.82 L19.79,16.88 A2,2 0 0 1 19.79,19.71 A2,2 0 0 1 16.96,19.71 L16.9,19.65 A1.65,1.65 0 0 0 15.08,19.32 A1.65,1.65 0 0 0 14.08,20.83 L14.08,21 A2,2 0 0 1 12.08,23 A2,2 0 0 1 10.08,21 L10.08,20.91 A1.65,1.65 0 0 0 9.08,19.4 A1.65,1.65 0 0 0 7.26,19.73 L7.2,19.79 A2,2 0 0 1 4.37,19.79 A2,2 0 0 1 4.37,16.96 L4.43,16.9 A1.65,1.65 0 0 0 4.76,15.08 A1.65,1.65 0 0 0 3.25,14.08 L3,14.08 A2,2 0 0 1 1,12.08 A2,2 0 0 1 3,10.08 L3.09,10.08 A1.65,1.65 0 0 0 4.6,9.08 A1.65,1.65 0 0 0 4.27,7.26 L4.21,7.2 A2,2 0 0 1 4.21,4.37 A2,2 0 0 1 7.04,4.37 L7.1,4.43 A1.65,1.65 0 0 0 8.92,4.76 A1.65,1.65 0 0 0 9.92,3.25 L9.92,3 A2,2 0 0 1 11.92,1 A2,2 0 0 1 13.92,3 L13.92,3.09 A1.65,1.65 0 0 0 14.92,4.6 A1.65,1.65 0 0 0 16.74,4.27 L16.8,4.21 A2,2 0 0 1 19.63,4.21 A2,2 0 0 1 19.63,7.04 L19.57,7.1 A1.65,1.65 0 0 0 19.24,8.92 A1.65,1.65 0 0 0 20.75,9.92 L21,9.92 A2,2 0 0 1 23,11.92 A2,2 0 0 1 21,13.92 L20.91,13.92 A1.65,1.65 0 0 0 19.4,15 Z M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z" />
                                <TextBlock Style="{StaticResource PanelTitle}" Text="01. 蓝图源定义" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 配置体 -->
                        <Grid Grid.Row="1" Margin="22,20,22,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 工程根目录 -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}"
                                           Margin="0,0,0,8">
                                    <Run Text="工程根目录 ROOT PATH" />
                                    <Run Text="　自动递归建目" Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                                </TextBlock>
                                <Border Grid.Row="1" Style="{StaticResource CapsuleBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="RootDirBox"
                                                     Style="{StaticResource BareTextBox}"
                                                     FontFamily="Segoe UI, Microsoft YaHei UI"
                                                     Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center" Padding="8,7" />
                                            <TextBlock Text="例如：D:\Projects"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceholderText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=RootDirBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="1" Content="定位目录" Style="{StaticResource GlassButton}"
                                                Padding="14,5" FontSize="11" FontWeight="Medium"
                                                Command="{Binding BrowseCommand}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 批量架构清单：代码编辑器风格 -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}"
                                           Margin="0,0,0,8">
                                    <Run Text="批量架构清单 TARGET MODULES" />
                                    <Run Text="　1 Line = 1 Solution" Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                                </TextBlock>
                                <Border Grid.Row="1" Background="{DynamicResource EditorBgBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 艺术行号栏（与编辑器滚动同步） -->
                                        <Border Grid.Column="0" Background="{DynamicResource LineNumBgBrush}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                                            <ScrollViewer x:Name="GutterScroll" VerticalScrollBarVisibility="Hidden">
                                                <TextBlock Text="{Binding LineNumbersText}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{DynamicResource LineNumBrush}"
                                                           Background="Transparent" Padding="10,12"
                                                           TextAlignment="Right" MinWidth="34" />
                                            </ScrollViewer>
                                        </Border>
                                        <!-- 绿色终端编辑区 -->
                                        <TextBox Grid.Column="1"
                                                 x:Name="NamesBox"
                                                 Style="{StaticResource BareTextBox}"
                                                 Text="{Binding ProjectNamesInput, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 Padding="14,12"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 Loaded="NamesBoxLoaded" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 操作区 -->
                            <Grid Grid.Row="2" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="重置" Style="{StaticResource GlassButton}"
                                        Height="44" Command="{Binding ClearCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M5,3 L19,12 L5,21 Z" Fill="{DynamicResource PrimaryBtnTextBrush}"
                                              Stretch="Uniform" Width="14" VerticalAlignment="Center" />
                                        <TextBlock Text="启动蓝图构建" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ 舞台 2：流水线日志明细 ═══ -->
                <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="22,18" BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="15,15,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource PanelTitleIcon}"
                                      Data="M4,17 L10,11 L4,5 M12,19 L20,19" />
                                <TextBlock Style="{StaticResource PanelTitle}" Text="02. 流水线日志明细" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <!-- 空态：艺术环 + 待命文案 -->
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasPipelineRun, Converter={StaticResource InverseBoolToVisibility}}">
                                <Grid Width="90" Height="90" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Ellipse Width="90" Height="90" Stroke="{DynamicResource RingOuterBrush}"
                                             StrokeThickness="1" StrokeDashArray="2 1.2">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RingSpin" CenterX="45" CenterY="45" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RingSpin"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:16"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Width="66" Height="66" Stroke="{DynamicResource RingInnerBrush}" StrokeThickness="1" />
                                    <Path Data="M21,16 L21,8 A2,2 0 0 0 20,6.27 L13,2.27 A2,2 0 0 0 11,2.27 L4,6.27 A2,2 0 0 0 3,8 L3,16 A2,2 0 0 0 4,17.73 L11,21.73 A2,2 0 0 0 13,21.73 L20,17.73 A2,2 0 0 0 21,16 Z"
                                          Stroke="{DynamicResource AuroraCyanBrush}" StrokeThickness="1.8"
                                          Stretch="Uniform" Width="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="工作台待命中" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextGlowBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="在左侧配置完成后点击「启动蓝图构建」，流水线将实时渲染多工程并发生成的原子步骤。"
                                           FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0"
                                           MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" />
                            </StackPanel>

                            <!-- 运行结果：统计 + 明细 + 未完成提醒 -->
                            <Grid Margin="20" Visibility="{Binding HasPipelineRun, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 统计徽章 -->
                                <Border Grid.Row="0" Background="{DynamicResource TagEmeraldBgBrush}"
                                        BorderBrush="{DynamicResource AuroraEmeraldBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,5"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource BadgeSuccessFgBrush}"
                                               Text="{Binding SummaryText}" />
                                </Border>

                                <!-- 明细列表 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource NodeBgBrush}" CornerRadius="8"
                                                        Padding="10,8" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 状态徽章 -->
                                                        <Border Grid.Column="0" CornerRadius="4" Padding="8,2"
                                                                BorderThickness="1" VerticalAlignment="Center" MinWidth="52">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TagEmeraldBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AuroraEmeraldBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                            <Setter Property="Background" Value="{DynamicResource BadgeWarningBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AuroraEmeraldBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Background" Value="{DynamicResource BadgeDangerBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BadgeSuccessFgBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BadgeWarningFgBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFgBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- 工程名 -->
                                                        <TextBlock Grid.Column="1" Text="{Binding ProjectName}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                                                   Foreground="{DynamicResource TextGlowBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="180"
                                                                   ToolTip="{Binding ProjectName}" />

                                                        <!-- 路径 / 原因 -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"
                                                                   Foreground="{DynamicResource TextDimBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Message}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- 未完成工程醒目提醒（需求 3.6） -->
                                <Border Grid.Row="2" Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                                        Visibility="{Binding HasIncomplete, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M7,0 L14,12 L0,12 Z M6.2,4 L7.8,4 L7.8,8 L6.2,8 Z M6.2,9.2 L7.8,9.2 L7.8,10.8 L6.2,10.8 Z"
                                                  Fill="{DynamicResource BadgeDangerFgBrush}" Stretch="Uniform"
                                                  Width="14" VerticalAlignment="Center" />
                                            <TextBlock Text="以下工程未成功创建，请重点关注"
                                                       FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource BadgeDangerFgBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding IncompleteText}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" FontSize="11" LineHeight="18"
                                                   Foreground="{DynamicResource TextSubBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══ 舞台 3：骨架拓扑预览 ═══ -->
                <Border Grid.Column="4" Style="{StaticResource GlassPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="22,18" BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="15,15,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource PanelTitleIcon}"
                                      Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M14,14 L21,14 L21,21 L14,21 Z M3,14 L10,14 L10,21 L3,21 Z" />
                                <TextBlock Style="{StaticResource PanelTitle}" Text="03. 骨架拓扑预览" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="20">
                            <!-- 空态 -->
                            <TextBlock Text="构建完成后，此处将实时渲染工程骨架拓扑。"
                                       FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding HasPipelineRun, Converter={StaticResource InverseBoolToVisibility}}" />

                            <!-- 可折叠拓扑树：工程根默认展开，其余层级点击箭头展开/收起 -->
                            <TreeView Style="{StaticResource TopologyTree}"
                                      ItemContainerStyle="{StaticResource TopologyItem}"
                                      ItemsSource="{Binding TreeRoots}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 文件夹 / 文件图标 -->
                                            <Grid Grid.Column="0" Width="15" VerticalAlignment="Center">
                                                <Path Data="M3,6 A2,2 0 0 1 5,4 L9,4 L11,6 L19,6 A2,2 0 0 1 21,8 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z"
                                                      Fill="{DynamicResource IconFolderBrush}" Stretch="Uniform"
                                                      Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />
                                                <Path Data="M6,2 L14,2 L18,6 L18,20 L6,20 Z"
                                                      Fill="{DynamicResource IconFileBrush}" Stretch="Uniform" Width="12"
                                                      Visibility="{Binding IsFolder, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </Grid>

                                            <!-- 节点名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,0,0"
                                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSubBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProjectRoot}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextGlowBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Initialized 徽标 -->
                                            <Border Grid.Column="2" Background="{DynamicResource TagEmeraldBgBrush}"
                                                    CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{Binding IsProjectRoot, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Initialized" FontSize="10"
                                                           Foreground="{DynamicResource TagEmeraldBrush}" />
                                            </Border>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
