<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Blueprint Studio 亮色主题令牌（昼间模式） ═══ -->

    <!-- 画布与容器 -->
    <SolidColorBrush x:Key="BgVoidBrush" Color="#F4F6FB" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#140F172A" />
    <SolidColorBrush x:Key="GlassBorderHoverBrush" Color="#28101624" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#0F0F172A" />
    <SolidColorBrush x:Key="NodeBgBrush" Color="#070F172A" />
    <SolidColorBrush x:Key="StatusPillBgBrush" Color="#0A0F172A" />

    <!-- 极光色板（昼间加深保证对比度） -->
    <SolidColorBrush x:Key="AuroraEmeraldBrush" Color="#059669" />
    <SolidColorBrush x:Key="AuroraCyanBrush" Color="#0891B2" />
    <SolidColorBrush x:Key="AuroraIndigoBrush" Color="#4F46E5" />

    <!-- 文本层级 -->
    <SolidColorBrush x:Key="TextGlowBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSubBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="FieldLabelBrush" Color="#0F172A" />

    <!-- 输入区 -->
    <SolidColorBrush x:Key="CapsuleBgBrush" Color="#0A0F172A" />
    <SolidColorBrush x:Key="EditorBgBrush" Color="#0A0F172A" />
    <SolidColorBrush x:Key="LineNumBgBrush" Color="#070F172A" />
    <SolidColorBrush x:Key="LineNumBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#059669" />

    <!-- 操作区 -->
    <LinearGradientBrush x:Key="PrimaryBtnGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBtnGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryBtnTextBrush" Color="#032018" />
    <SolidColorBrush x:Key="GemIconStrokeBrush" Color="#04170F" />

    <!-- 空态艺术环 -->
    <SolidColorBrush x:Key="RingOuterBrush" Color="#400891B2" />
    <SolidColorBrush x:Key="RingInnerBrush" Color="#40059669" />

    <!-- 拓扑节点 -->
    <SolidColorBrush x:Key="IconFolderBrush" Color="#D97706" />
    <SolidColorBrush x:Key="IconFileBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="TagEmeraldBrush" Color="#059669" />
    <SolidColorBrush x:Key="TagEmeraldBgBrush" Color="#1A10B981" />

    <!-- 状态徽章 -->
    <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#059669" />
    <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#B45309" />
    <SolidColorBrush x:Key="BadgeDangerFgBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="BadgeDangerBgBrush" Color="#1AEF4444" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1CEF4444" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#66EF4444" />

    <!-- 氛围背景：昼间极光光晕更淡 + 网格换深色细线 -->
    <RadialGradientBrush x:Key="BlobEmeraldBrush">
        <GradientStop Color="#1A10B981" Offset="0" />
        <GradientStop Color="#0806B6D4" Offset="0.5" />
        <GradientStop Color="#0006B6D4" Offset="0.7" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BlobIndigoBrush">
        <GradientStop Color="#146366F1" Offset="0" />
        <GradientStop Color="#0610B981" Offset="0.5" />
        <GradientStop Color="#0010B981" Offset="0.75" />
    </RadialGradientBrush>
    <DrawingBrush x:Key="MeshBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 L32,0 M0,0 L0,32">
                <GeometryDrawing.Pen>
                    <Pen Brush="#0A0F172A" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
