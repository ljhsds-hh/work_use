<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Blueprint Studio 暗色主题令牌（基准：模板.html） ═══ -->

    <!-- 画布与容器 -->
    <SolidColorBrush x:Key="BgVoidBrush" Color="#06080F" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#6606080F" />
    <SolidColorBrush x:Key="GlassCardBrush" Color="#A6101624" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderHoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="NodeBgBrush" Color="#05FFFFFF" />
    <SolidColorBrush x:Key="StatusPillBgBrush" Color="#08FFFFFF" />

    <!-- 极光色板 -->
    <SolidColorBrush x:Key="AuroraEmeraldBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AuroraCyanBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AuroraIndigoBrush" Color="#6366F1" />

    <!-- 文本层级 -->
    <SolidColorBrush x:Key="TextGlowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSubBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#475569" />
    <SolidColorBrush x:Key="FieldLabelBrush" Color="#E2E8F0" />

    <!-- 输入区 -->
    <SolidColorBrush x:Key="CapsuleBgBrush" Color="#59000000" />
    <SolidColorBrush x:Key="EditorBgBrush" Color="#73000000" />
    <SolidColorBrush x:Key="LineNumBgBrush" Color="#05FFFFFF" />
    <SolidColorBrush x:Key="LineNumBrush" Color="#475569" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#10B981" />

    <!-- 操作区 -->
    <LinearGradientBrush x:Key="PrimaryBtnGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryBtnGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryBtnTextBrush" Color="#032018" />
    <SolidColorBrush x:Key="GemIconStrokeBrush" Color="#04170F" />

    <!-- 空态艺术环 -->
    <SolidColorBrush x:Key="RingOuterBrush" Color="#4D06B6D4" />
    <SolidColorBrush x:Key="RingInnerBrush" Color="#4010B981" />

    <!-- 拓扑节点 -->
    <SolidColorBrush x:Key="IconFolderBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="IconFileBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="TagEmeraldBrush" Color="#10B981" />
    <SolidColorBrush x:Key="TagEmeraldBgBrush" Color="#1A10B981" />

    <!-- 状态徽章 -->
    <SolidColorBrush x:Key="BadgeSuccessFgBrush" Color="#34D399" />
    <SolidColorBrush x:Key="BadgeWarningFgBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="BadgeDangerFgBrush" Color="#F87171" />
    <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="BadgeDangerBgBrush" Color="#1AEF4444" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1CEF4444" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#66EF4444" />

    <!-- 氛围背景：极光光晕 + 蓝图网格 -->
    <RadialGradientBrush x:Key="BlobEmeraldBrush">
        <GradientStop Color="#2E10B981" Offset="0" />
        <GradientStop Color="#0D06B6D4" Offset="0.5" />
        <GradientStop Color="#0006B6D4" Offset="0.7" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BlobIndigoBrush">
        <GradientStop Color="#266366F1" Offset="0" />
        <GradientStop Color="#0A10B981" Offset="0.5" />
        <GradientStop Color="#0010B981" Offset="0.75" />
    </RadialGradientBrush>
    <DrawingBrush x:Key="MeshBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 L32,0 M0,0 L0,32">
                <GeometryDrawing.Pen>
                    <Pen Brush="#05FFFFFF" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
