<Window x:Class="QuietRemind.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding TitleText}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" Background="White"
        Foreground="#0F172A"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="1"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding TitleText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Height="40" Width="46"
                        Click="OnCancel" ToolTip="取消">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </DockPanel>
        </Border>

        <!-- 表单 -->
        <StackPanel Grid.Row="1" Margin="24,20,24,24">
            <TextBlock Text="任务内容" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6" />
            <hc:TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />

            <TextBlock Text="循环规则" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,16,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="单次" IsChecked="{Binding IsOnce, Mode=OneWay}" GroupName="Recurrence" Margin="0,0,14,0" Tag="Once" Checked="OnRecurrenceChecked" />
                <RadioButton Content="每天" IsChecked="{Binding IsDaily, Mode=OneWay}" GroupName="Recurrence" Margin="0,0,14,0" Tag="Daily" Checked="OnRecurrenceChecked" />
                <RadioButton Content="每周" IsChecked="{Binding IsWeekly, Mode=OneWay}" GroupName="Recurrence" Margin="0,0,14,0" Tag="Weekly" Checked="OnRecurrenceChecked" />
                <RadioButton Content="每月" IsChecked="{Binding IsMonthly, Mode=OneWay}" GroupName="Recurrence" Tag="Monthly" Checked="OnRecurrenceChecked" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding IsOnce, Converter={StaticResource BoolToVis}}">
                <StackPanel Width="150" Margin="0,0,24,0">
                    <TextBlock Text="日期" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6" />
                    <hc:DatePicker SelectedDate="{Binding SingleDate}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="开始日期" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,2" />
                <TextBlock Text="任务从该日开始提醒，留空默认从今天开始" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />
                <hc:DatePicker SelectedDate="{Binding StartDate}" Width="180" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="星期" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,6,8,0" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <CheckBox Content="一" IsChecked="{Binding Mon}" Margin="0,0,8,0" />
                    <CheckBox Content="二" IsChecked="{Binding Tue}" Margin="0,0,8,0" />
                    <CheckBox Content="三" IsChecked="{Binding Wed}" Margin="0,0,8,0" />
                    <CheckBox Content="四" IsChecked="{Binding Thu}" Margin="0,0,8,0" />
                    <CheckBox Content="五" IsChecked="{Binding Fri}" Margin="0,0,8,0" />
                    <CheckBox Content="六" IsChecked="{Binding Sat}" Margin="0,0,8,0" />
                    <CheckBox Content="日" IsChecked="{Binding Sun}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="每月" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,6,8,0" />
                <hc:NumericUpDown Value="{Binding MonthDay, Mode=TwoWay}" Minimum="1" Maximum="31" Width="72" />
                <TextBlock Text="日提醒" FontSize="12" Foreground="#64748B" Margin="8,6,0,0" />
            </StackPanel>

            <TextBlock Text="提醒时刻" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,16,0,6" />
            <Grid HorizontalAlignment="Left">
                <ToggleButton x:Name="TimeTriggerButton" Style="{StaticResource TimeTriggerButton}"
                              IsChecked="{Binding IsTimePanelOpen, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#0F172A" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                   Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </ToggleButton>

                <Popup IsOpen="{Binding IsTimePanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=TimeTriggerButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Style="{StaticResource TimePanelCard}">
                        <StackPanel>
                            <TextBlock Text="时（24 小时制）" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#94A3B8" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding Hours}"
                                     SelectedItem="{Binding SelectedHour, Mode=TwoWay}"
                                     ItemsPanel="{StaticResource TimeCellPanel}"
                                     ItemContainerStyle="{StaticResource TimeCell}"
                                     ItemTemplate="{StaticResource TimeCellText}"
                                     Width="276" Padding="0" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <TextBlock Text="分" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#94A3B8" Margin="0,12,0,4" />
                            <ListBox ItemsSource="{Binding Minutes}"
                                     SelectedItem="{Binding SelectedMinute, Mode=TwoWay}"
                                     ItemsPanel="{StaticResource TimeCellPanel}"
                                     ItemContainerStyle="{StaticResource TimeCell}"
                                     ItemTemplate="{StaticResource TimeCellText}"
                                     Width="276" Padding="0" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseUp="OnMinutePicked" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="常用" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Style="{StaticResource PresetTimeChip}" Content="08:00" Tag="08:00" Click="OnPresetTime" />
                <Button Style="{StaticResource PresetTimeChip}" Content="09:00" Tag="09:00" Click="OnPresetTime" />
                <Button Style="{StaticResource PresetTimeChip}" Content="12:00" Tag="12:00" Click="OnPresetTime" />
                <Button Style="{StaticResource PresetTimeChip}" Content="14:00" Tag="14:00" Click="OnPresetTime" />
                <Button Style="{StaticResource PresetTimeChip}" Content="18:00" Tag="18:00" Click="OnPresetTime" />
                <Button Style="{StaticResource PresetTimeChip}" Content="21:00" Tag="21:00" Click="OnPresetTime" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorText}" Foreground="#EF4444" TextWrapping="Wrap"
                       FontSize="12" Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Width="92" Height="34" Click="OnCancel" Cursor="Hand"
                        Background="White" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="保存" Width="92" Height="34" Style="{StaticResource PrimaryButton}"
                        Margin="12,0,0,0" Click="OnSave" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
