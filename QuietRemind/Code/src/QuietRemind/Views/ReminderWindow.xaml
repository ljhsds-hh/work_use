<Window x:Class="QuietRemind.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietRemind 到期提醒"
        WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        Background="{DynamicResource BOverlayBase}"
        Foreground="{DynamicResource BInk}"
        FontFamily="{StaticResource FontBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Image x:Name="BackdropImage" Stretch="UniformToFill" Visibility="Collapsed" />
        <Border x:Name="DimLayer" Background="{DynamicResource BOverlayBase}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                      Padding="0,28" Focusable="False">
            <Grid Margin="24">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ScaleTransform" ScaleX="0.985" ScaleY="0.985" />
                        <TranslateTransform x:Name="FloatTransform" Y="18" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Border Background="{DynamicResource BSurface}" CornerRadius="20" Width="620"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BHairline}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="56" ShadowDepth="18" Direction="270"
                                          Opacity="0.42" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <StackPanel>
                            <!-- 预览提示条 -->
                            <Border Background="{DynamicResource BAmberSoft}" BorderBrush="{DynamicResource BWarningLine}"
                                    BorderThickness="0,0,0,1" Padding="20,10"
                                    CornerRadius="19,19,0,0"
                                    Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                                   Foreground="{DynamicResource BAmber}" VerticalAlignment="Center" />
                                        <TextBlock Text="预览模式 · 不会写入任何数据" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BAmber}" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="关闭预览" Click="OnClosePreview"
                                            Style="{StaticResource GhostButton}" Height="27" Padding="9,0"
                                            FontSize="11" Foreground="{DynamicResource BAmberHover}" />
                                </DockPanel>
                            </Border>

                            <!-- 头部 -->
                            <DockPanel Margin="22,18,22,0" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" Background="{DynamicResource BAccent}" CornerRadius="9">
                                        <TextBlock Text="Q" FontFamily="{StaticResource FontDisplay}" FontSize="14"
                                                   FontWeight="Bold" Foreground="{DynamicResource BOnAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="QuietRemind" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BInkSoft}" />
                                        <TextBlock Text="到期提醒" FontSize="10.5" Foreground="{DynamicResource BFaint}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="计划时刻" Style="{StaticResource OverlineText}"
                                               HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                                   Foreground="{DynamicResource BAmber}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HeaderTime}" FontFamily="{StaticResource FontNumeric}"
                                                   FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BInk}"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- 任务条目 -->
                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BHairlineSoft}" BorderThickness="0,0,0,1"
                                                Margin="22,0">
                                            <StackPanel Margin="0,17,0,18">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                                <Setter Property="Opacity" Value="0.4" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <DockPanel LastChildFill="False" Margin="0,0,0,15">
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="410">
                                                        <TextBlock Text="{Binding Content}" FontFamily="{StaticResource FontDisplay}"
                                                                   FontSize="19" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BInk}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Content}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                    Visibility="{Binding IsMissed, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="10"
                                                                       Foreground="{DynamicResource BDanger}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5"
                                                                       Foreground="{DynamicResource BDanger}" Margin="5,0,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Grid Grid.Column="1" DockPanel.Dock="Right" ClipToBounds="True"
                                                          VerticalAlignment="Center">
                                                        <ContentControl Content="{Binding BadgeText}" HorizontalAlignment="Right">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl" BasedOn="{StaticResource PillGreen}">
                                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMissed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BDanger}" />
                                                                            <Setter Property="Background" Value="{DynamicResource BDangerSoft}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </Grid>
                                                </DockPanel>

                                                <DockPanel LastChildFill="False"
                                                           Visibility="{Binding ShowActions, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompleteCommand}"
                                                            DockPanel.Dock="Left" Padding="15,0" Height="36">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="11" Height="11" Stretch="None" Stroke="{DynamicResource BOnAccent}" StrokeThickness="2.4"
                                                                  Data="M1,6 L4.5,9.5 L11,1" />
                                                            <TextBlock Text="完成" Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Border DockPanel.Dock="Left" Style="{StaticResource ButtonGroupBorder}"
                                                            Margin="9,0,0,0" SnapsToDevicePixels="True">
                                                        <ItemsControl ItemsSource="{Binding SnoozeOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource GroupSegmentButton}"
                                                                            Content="{Binding Label}" Command="{Binding Command}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>

                                                    <Button Style="{StaticResource GhostButton}" Command="{Binding SkipCommand}"
                                                            Content="跳过" DockPanel.Dock="Right" Height="36" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 底部提示 -->
                            <Border BorderBrush="{DynamicResource BHairlineSoft}" BorderThickness="0,1,0,0"
                                    Padding="22,12" Background="{DynamicResource BSurfaceAlt}" CornerRadius="0,0,19,19">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FontIcon}" FontSize="10"
                                                   Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FooterText}" FontSize="10.5"
                                                   Foreground="{DynamicResource BFaint}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, StringFormat={}{0} 条}"
                                               FontFamily="{StaticResource FontNumeric}" FontSize="10.5"
                                               Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FloatTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.985" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.985" To="1" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
