<Window x:Class="QuietRemind.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietRemind 到期提醒"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        Background="White"
        Foreground="#0F172A"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        KeyDown="OnKeyDown"
        SourceInitialized="OnSourceInitialized">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 左侧品牌状态条 + 内容 -->
    <Grid Margin="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="FloatTransform" Y="16" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2563EB" />

        <StackPanel Grid.Column="1">
            <!-- 头部：品牌 + 计划时刻 -->
            <DockPanel Margin="14,12,16,0" LastChildFill="False" Background="Transparent"
                       MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" Background="#2563EB" CornerRadius="4">
                        <TextBlock Text="Q" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="QuietRemind · 到期提醒" FontSize="12" FontWeight="SemiBold"
                               Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#EF4444"
                          Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 M12,4 A8,8 0 1 1 4,12 A8,8 0 0 1 12,4 M11,6 L13,6 L13,12 L16.5,14 L15.6,15.7 L11,13 Z" />
                    <TextBlock Text="{Binding HeaderTime}" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- 任务块列表 -->
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="20,12,20,18">
                            <!-- 任务标题 + 徽标 -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,14">
                                <TextBlock Text="{Binding Content}" FontSize="17" FontWeight="Bold"
                                           Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Content}"
                                           VerticalAlignment="Center" DockPanel.Dock="Left" MaxWidth="360" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BadgeText}" FontSize="11"
                                           Foreground="#2563EB" Background="#EFF6FF" Padding="8,2"
                                           VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TagBadge}">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissed}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <!-- 操作行：完成 / 稍后再提醒分段 / 跳过 -->
                            <DockPanel LastChildFill="False">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompleteCommand}"
                                        DockPanel.Dock="Left" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="None" Stroke="White" StrokeThickness="3"
                                              Data="M1,7 L5,11 L12,1" />
                                        <TextBlock Text="完成" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <Border DockPanel.Dock="Left" Style="{StaticResource ButtonGroupBorder}"
                                        Margin="10,0,0,0" SnapsToDevicePixels="True">
                                    <ItemsControl ItemsSource="{Binding SnoozeOptions}"
                                                  AlternationCount="{Binding SnoozeOptions.Count}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl>
                                                    <Button Style="{StaticResource GroupSegmentButton}"
                                                            Content="{Binding Label}" Command="{Binding Command}" />
                                                </ContentControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Button Style="{StaticResource GhostButton}" Command="{Binding SkipCommand}"
                                        Content="跳过" DockPanel.Dock="Right" />
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 收尾提示 -->
            <TextBlock Text="请对每条任务做出处理（完成 / 稍后再提醒 / 跳过）"
                       FontSize="11" Foreground="#94A3B8" Margin="20,0,20,14" />
        </StackPanel>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="FloatTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
