<Window x:Class="QuietRemind.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        WindowStyle="None" Topmost="True" WindowState="Maximized"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#CC101018"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- 全屏遮罩 + 居中任务卡片（需求 3.2）：弹入缩放 + 边框呼吸，无花瓣动画、无声音 -->
        <hc:Card Width="560" MaxHeight="640" Padding="28"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Background="#FFFDFDFD"
                 BorderBrush="#FF3478F6" BorderThickness="2"
                 Opacity="0">
            <hc:Card.RenderTransform>
                <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
            </hc:Card.RenderTransform>
            <hc:Card.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.92" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.92" To="1" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)"
                                             From="0.35" To="1" AutoReverse="True" RepeatBehavior="Forever" Duration="0:0:1.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </hc:Card.Triggers>
            <StackPanel>
                <TextBlock Text="QuietRemind 提醒" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <Border Background="#FFFFF3E0" CornerRadius="4" Padding="8,4" Margin="0,10,0,0"
                        Visibility="{Binding IsMissedWindow, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="以下任务已错过，请确认处理" Foreground="#FF8A5A00" FontSize="13" HorizontalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#223478F6" BorderThickness="1" CornerRadius="8"
                                    Padding="14,12" Margin="0,10,0,0" Background="#0D000000">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding TimeText}" Foreground="#FF808080"
                                                   DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Text="{Binding Content}" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,10,0" />
                                    </DockPanel>
                                    <Border Background="#FFFF4D4F" CornerRadius="3" Padding="6,2"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding IsMissed, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="已错过" Foreground="White" FontSize="11" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="完成" Command="{Binding CompleteCommand}"
                                                   Style="{StaticResource ButtonPrimary}" Width="72" Height="30" />
                                        <ItemsControl ItemsSource="{Binding SnoozeOptions}" Margin="8,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" Command="{Binding Command}"
                                                               Height="30" Margin="0,0,6,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="跳过" Command="{Binding SkipCommand}" Width="72" Height="30" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="请对每一条任务做出处理（完成 / 稍后再提醒 / 跳过）"
                           Foreground="#FF808080" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </hc:Card>
    </Grid>
</Window>
