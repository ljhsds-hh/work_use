                                    Background="Transparent" Foreground="{DynamicResource BRailFaint}" BorderThickness="0"
                                    FontSize="11" Cursor="Hand" Margin="14,0,0,0" Padding="0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ================= 设置检查器（默认收起，按需展开） ================= -->
            <Border x:Name="SettingsPanel" Grid.Column="1" Background="{DynamicResource BSurface}"
                    BorderBrush="{DynamicResource BHairline}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource BHairline}" BorderThickness="0,0,0,1" Padding="20,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PREFERENCES" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="设置" Style="{StaticResource SectionTitle}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource RowIconButton}"
                                    Click="OnToggleSettings" ToolTip="收起设置"
                                    AutomationProperties.Name="收起设置" VerticalAlignment="Center">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource FontIcon}" FontSize="12" />
                            </Button>
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,18,20,26">
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="外观" Style="{StaticResource SectionLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource SectionRule}" />
                            </Grid>

                            <Border Style="{StaticResource SettingCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel VerticalAlignment="Center" MaxWidth="150">
                                            <TextBlock Text="界面模式" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BInk}" />
                                            <TextBlock Text="深色适合夜间，浅色适合明亮环境" Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource BSegmentTrack}"
                                                CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="浅色" GroupName="ThemeMode"
                                                             Style="{StaticResource SegmentRadio}"
                                                             IsChecked="{Binding IsLightMode, Mode=TwoWay}" />
                                                <RadioButton Content="深色" GroupName="ThemeMode"
                                                             Style="{StaticResource SegmentRadio}"
                                                             IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <Border Height="1" Background="{DynamicResource BHairlineSoft}" Margin="0,14,0,12" />

                                    <TextBlock Text="主题色" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BInk}" />
                                    <TextBlock Text="用于按钮、链接与选中态" Style="{StaticResource FieldHint}"
                                               Margin="0,3,0,0" />
                                    <ItemsControl ItemsSource="{Binding ThemeAccentOptions}" Margin="0,11,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,12,0" ToolTip="{Binding Name}">
                                                    <Button Style="{StaticResource AccentSwatch}"
                                                            Background="{Binding PreviewBrush}"
                                                            Command="{Binding SelectCommand}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                               HorizontalAlignment="Center" Margin="0,5,0,0"
                                                               Foreground="{DynamicResource BFaint}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="通用" Style="{StaticResource SectionLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource SectionRule}" />
                            </Grid>

                            <Border Style="{StaticResource SettingCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="34" Height="34">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                   Foreground="{DynamicResource BAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="开机自启与进程守护" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BInk}" />
                                        <TextBlock Text="注册计划任务，误退自动拉起" Style="{StaticResource FieldHint}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggle}"
                                                  IsChecked="{Binding GuardEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="开机自启与进程守护" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="34" Height="34">
                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                   Foreground="{DynamicResource BAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="快速新增快捷键" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BInk}" />
                                        <TextBlock Text="Ctrl + Alt + N 呼出轻量新增窗" Style="{StaticResource FieldHint}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggle}"
                                                  IsChecked="{Binding QuickAddHotkeyEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="快速新增快捷键" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,22,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="提醒" Style="{StaticResource SectionLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource SectionRule}" />
                            </Grid>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTileAmber}" Width="34" Height="34">
                                            <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                       Foreground="{DynamicResource BAmber}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="提前提醒" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BInk}" />
                                            <TextBlock Text="到点前托盘气泡预告" Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding PreAlertEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="提前提醒" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="45,12,0,0"
                                                Visibility="{Binding PreAlertEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="提前" FontSize="11.5" Foreground="{DynamicResource BMuted}"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource IntervalBox}" Width="86" Margin="7,0,0,0">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Right" Text="分" FontSize="11"
                                                           Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource IntervalTextBox}"
                                                         Text="{Binding PreAlertMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}" Width="34" Height="34">
                                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                       Foreground="{DynamicResource BAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="提醒外观" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BInk}" />
                                            <TextBlock Text="自定义遮罩背景，实时预览暗化与模糊" Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="45,11,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Height="30" Padding="11,0"
                                                Command="{Binding PickImageCommand}" ToolTip="支持 jpg / png / bmp"
                                                AutomationProperties.Name="上传提醒背景图">
                                            <TextBlock Text="上传图片" FontSize="11.5" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Height="30" Padding="8,0"
                                                Command="{Binding ClearImageCommand}" Content="清除" FontSize="11.5"
                                                Margin="4,0,0,0"
                                                Visibility="{Binding HasCustomImage, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReminderImageText}" FontSize="10.5"
                                               Foreground="{DynamicResource BFaint}"
                                               TextTrimming="CharacterEllipsis" Margin="45,7,0,0"
                                               ToolTip="{Binding ReminderImageText}" />

                                    <!-- 实时预览：背景图 + 当前暗化/模糊，滑块拖动即时反映 -->
                                    <Border Margin="45,10,0,0" Height="132" CornerRadius="10"
                                            Background="{DynamicResource BOverlayBase}"
                                            BorderBrush="{DynamicResource BHairline}" BorderThickness="1"
                                            ClipToBounds="True" SnapsToDevicePixels="True"
                                            ToolTip="按当前暗化与模糊参数实时预览">
                                        <Grid>
                                            <Image Source="{Binding ReminderPreviewSource}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasReminderPreview, Converter={StaticResource BoolToVis}}">
                                                <Image.Effect>
                                                    <BlurEffect Radius="{Binding ReminderBlurRadius}" KernelType="Gaussian" />
                                                </Image.Effect>
                                            </Image>

                                            <!-- 暗化层 -->
                                            <Border Background="{DynamicResource BOverlayBase}"
                                                    Opacity="{Binding ReminderDimOpacity}" />

                                            <!-- 无背景图提示：暗化层之上，保证可读 -->
                                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="9,8,0,0"
                                                    Background="{DynamicResource BSurface}" Opacity="0.92"
                                                    CornerRadius="6" Padding="7,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasReminderPreview}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource FontIcon}" FontSize="10"
                                                               Foreground="{DynamicResource BMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Text="未选择背景图 · 上传后可实时预览" FontSize="10"
                                                               Foreground="{DynamicResource BMuted}" Margin="5,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 迷你提醒卡示意 -->
                                            <Border Width="170" Height="60" CornerRadius="9"
                                                    Background="{DynamicResource BSurface}"
                                                    BorderBrush="{DynamicResource BHairline}" BorderThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Margin="12,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="16" Height="16" CornerRadius="5"
                                                                Background="{DynamicResource BAccent}" />
                                                        <Border Height="5" Width="54" CornerRadius="2"
                                                                Background="{DynamicResource BInk}" Opacity="0.72"
                                                                Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Height="4" Width="92" CornerRadius="2"
                                                            Background="{DynamicResource BFaint}" Opacity="0.5"
                                                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Button Style="{StaticResource ActionLinkButton}" Content="全屏预览提醒 →"
                                            Command="{Binding PreviewReminderCommand}" HorizontalAlignment="Left"
                                            Margin="45,10,0,0" ToolTip="以同样的主屏全屏样式预览，不会写入数据" />

                                    <Grid Margin="45,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="暗化程度" FontSize="11.5" Foreground="{DynamicResource BMuted}" />
                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource FontNumeric}"
                                                   FontSize="11" Foreground="{DynamicResource BFaint}"
                                                   Text="{Binding ReminderDimPercent, StringFormat={}{0}%}" />
                                    </Grid>
                                    <Slider Style="{StaticResource SlimSlider}" Minimum="0" Maximum="90"
                                            Value="{Binding ReminderDimPercent, Delay=250}"
                                            IsSnapToTickEnabled="True" TickFrequency="5"
                                            Margin="45,1,0,0" />
                                    <Grid Margin="45,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="图片模糊" FontSize="11.5" Foreground="{DynamicResource BMuted}" />
                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource FontNumeric}"
                                                   FontSize="11" Foreground="{DynamicResource BFaint}"
                                                   Text="{Binding ReminderBlurRadius, StringFormat={}{0}}" />
                                    </Grid>
                                    <Slider Style="{StaticResource SlimSlider}" Minimum="0" Maximum="40"
                                            Value="{Binding ReminderBlurRadius, Delay=250}"
                                            IsSnapToTickEnabled="True" TickFrequency="2"
                                            Margin="45,1,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTileAmber}" Width="34" Height="34">
                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                       Foreground="{DynamicResource BAmber}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="稍后提醒预设" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BInk}" />
                                            <TextBlock Text="三个候选间隔" Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="3" Margin="45,10,0,0">
                                        <Border Style="{StaticResource IntervalBox}" Margin="0,0,6,0">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Right" Text="分" FontSize="10.5"
                                                           Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource IntervalTextBox}"
                                                         Text="{Binding Snooze1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource IntervalBox}" Margin="0,0,6,0">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Right" Text="分" FontSize="10.5"
                                                           Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource IntervalTextBox}"
                                                         Text="{Binding Snooze2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource IntervalBox}">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Right" Text="分" FontSize="10.5"
                                                           Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource IntervalTextBox}"
                                                         Text="{Binding Snooze3, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,22,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据与状态" Style="{StaticResource SectionLabel}" />
                                <Border Grid.Column="1" Style="{StaticResource SectionRule}" />
                            </Grid>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}" Width="34" Height="34">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                       Foreground="{DynamicResource BAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="数据备份" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BInk}" />
                                            <TextBlock Text="导出/导入任务、设置与历史"
                                                       Style="{StaticResource FieldHint}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="45,10,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" Height="30" Padding="11,0"
                                                Command="{Binding ExportBackupCommand}">
                                            <TextBlock Text="导出备份" FontSize="11.5" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Height="30" Padding="8,0"
                                                Content="导入备份" FontSize="11.5" Command="{Binding ImportBackupCommand}"
                                                Margin="4,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTileNeutral}" Width="34" Height="34">
                                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                                       Foreground="{DynamicResource BMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="运行状态" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BInk}" />
                                            <TextBlock Text="守护、快捷键与落盘情况" Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource ActionLinkButton}" Content="刷新"
                                                Command="{Binding RefreshDiagnosticsCommand}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Border CornerRadius="999" Padding="8,3" Margin="45,10,0,0" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BSuccessSoft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDiagnosticsWarning}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BDangerSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource BSuccess}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDiagnosticsWarning}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource BDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="运行正常" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BSuccess}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDiagnosticsWarning}" Value="True">
                                                                <Setter Property="Text" Value="需要关注" />
                                                                <Setter Property="Foreground" Value="{DynamicResource BDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding DiagnosticsSummary}" FontSize="11.5" Margin="45,8,0,0"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BSuccess}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDiagnosticsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BDanger}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DiagnosticsDetail}" FontSize="10.5"
                                               Foreground="{DynamicResource BFaint}" TextWrapping="Wrap"
                                               LineHeight="16" Margin="45,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="45,9,0,0">
                                        <Button Style="{StaticResource ActionLinkButton}" Content="修复守护"
                                                Command="{Binding RepairGuardCommand}" />
                                        <Button Style="{StaticResource ActionLinkButton}" Content="打开日志"
                                                Command="{Binding OpenLogCommand}" Margin="16,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AlertBox}" Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FontIcon}" FontSize="13"
                                               Foreground="{DynamicResource BAccent}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                        <TextBlock Text="常驻托盘" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource BAccent}" />
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource BAccent}"
                                                   TextWrapping="Wrap" LineHeight="17" Margin="0,3,0,0"
                                                   Text="关闭主窗口不会退出。关机前、到点或开机后会自动检查未处理事项，双击托盘图标可重新呼出。" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
