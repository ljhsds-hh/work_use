<Window x:Class="QuietRemind.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuietRemind 任务提醒"
        Width="960" Height="600" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="White"
        Foreground="#0F172A"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏（白底，可拖动） ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#2563EB"
                          Data="M12,2 A10,10 0 1 0 22,12 A10,10 0 0 0 12,2 M12,4 A8,8 0 1 1 4,12 A8,8 0 0 1 12,4 M11,6 L13,6 L13,12 L16.5,14 L15.6,15.7 L11,13 Z" />
                    <TextBlock Text="QuietRemind 任务提醒" FontSize="12" FontWeight="SemiBold"
                               Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Height="40" Click="OnMinimize" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Height="40"
                            Click="OnToggleMaximize" ToolTip="最大化 / 还原">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Height="40" Click="OnCloseToTray"
                            ToolTip="关闭（最小化到托盘）">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 内容区：左任务列表 + 右设置栏 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- 左：任务列表主区 -->
            <Grid Background="#F1F5F9" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="24,24,24,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="None" Stroke="White" StrokeThickness="2.5"
                                  Data="M6,0 L6,12 M0,6 L12,6" />
                            <TextBlock Text="新增任务" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="任务列表" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                        <Border Style="{StaticResource CountBadge}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding PendingCountText}" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 卡片表格 -->
                        <Border Style="{StaticResource TableCard}">
                            <StackPanel>
                                <!-- 表头 -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3.2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="任务内容" Margin="16,12" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="循环规则" Margin="0,12" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="下次提醒" Margin="0,12" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="状态" Margin="0,12" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="操作" Margin="0,12,16,12" />
                                    </Grid>
                                </Border>
                                <!-- 数据行 -->
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid Margin="0" Height="52" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="2.5*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1.3*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource TableCellText}"
                                                               FontWeight="SemiBold" Text="{Binding Content}" Margin="16,0" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Content}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RecurrenceText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TagBadge}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="Daily">
                                                                        <Setter Property="Foreground" Value="#059669" />
                                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="Monthly">
                                                                        <Setter Property="Foreground" Value="#EA580C" />
                                                                        <Setter Property="Background" Value="#FFF7ED" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="Once">
                                                                        <Setter Property="Foreground" Value="#64748B" />
                                                                        <Setter Property="Background" Value="#F1F5F9" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Margin="0,0,0,0" VerticalAlignment="Center"
                                                               FontSize="13" Text="{Binding NextRemindText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
                                                                <Setter Property="Foreground" Value="#64748B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTodayDue}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ToggleButton Grid.Column="3" Style="{StaticResource SwitchToggle}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  HorizontalAlignment="Left" Margin="0,0,16,0" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <Button Style="{StaticResource ActionLinkButton}" Content="编辑"
                                                                Command="{Binding EditCommand}" />
                                                        <Button Style="{StaticResource ActionLinkDanger}" Content="删除"
                                                                Command="{Binding DeleteCommand}" Margin="12,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#F8FAFC" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 空状态 -->
                        <TextBlock Text="暂无任务，点击右上角「新增任务」创建第一条提醒"
                                   FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"
                                   Margin="0,48,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoTask}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 右：设置偏好 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="设置偏好" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,20" />

                    <!-- 守护开关卡 -->
                    <Border Grid.Row="1" Style="{StaticResource SettingCard}">
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Text="开机自启与进程守护" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="注册 Windows 计划任务" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding GuardEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- 提醒背景 -->
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock Text="提醒背景" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2" />
                        <TextBlock Text="弹窗遮罩可上传图片，并调整暗化与模糊" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <DockPanel LastChildFill="False">
                            <Button Style="{StaticResource PrimaryButton}" Height="28" Padding="12,0"
                                    Command="{Binding PickImageCommand}" ToolTip="支持 jpg / png / bmp">
                                <TextBlock Text="上传图片" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Height="28" Command="{Binding ClearImageCommand}"
                                    Content="清除" DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Visibility="{Binding HasCustomImage, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ReminderImageText}" FontSize="11" Foreground="#94A3B8"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                   ToolTip="{Binding ReminderImageText}" />
                        <TextBlock Text="暗化程度" FontSize="11" Foreground="#64748B" Margin="0,10,0,2" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#94A3B8"
                                       Text="{Binding ReminderDimPercent, StringFormat={}{0}%}" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="90" Value="{Binding ReminderDimPercent}"
                                    IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                        <TextBlock Text="图片模糊" FontSize="11" Foreground="#64748B" Margin="0,10,0,2" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#94A3B8"
                                       Text="{Binding ReminderBlurRadius, StringFormat={}{0}}" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="40" Value="{Binding ReminderBlurRadius}"
                                    IsSnapToTickEnabled="True" TickFrequency="2" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel>
                    </StackPanel>

                    <!-- 稍后提醒预设 -->
                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                        <TextBlock Text="稍后提醒预设" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,2" />
                        <TextBlock Text="提醒窗口点击稍后提醒时可供选择的分钟数" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource IntervalBox}" Margin="0,0,8,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Right" Text="分" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource IntervalTextBox}" Text="{Binding Snooze1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource IntervalBox}" Margin="0,0,8,0">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Right" Text="分" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource IntervalTextBox}" Text="{Binding Snooze2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource IntervalBox}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Right" Text="分" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource IntervalTextBox}" Text="{Binding Snooze3, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 底部说明（贴近底边） -->
                    <Border Grid.Row="5" Style="{StaticResource AlertBox}">
                        <StackPanel>
                            <TextBlock Text="系统托盘运行说明" FontSize="11" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,2" />
                            <TextBlock FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"
                                       LineHeight="18"
                                       Text="本工具常驻系统托盘，关机前、到点或开机后会自动检查未处理事项。双击托盘图标可重新呼出主面板。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
