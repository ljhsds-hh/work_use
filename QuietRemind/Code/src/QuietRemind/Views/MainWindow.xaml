<Window x:Class="QuietRemind.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuietRemind 任务提醒"
        Width="1280" Height="820" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BCanvas}"
        Foreground="{DynamicResource BInk}"
        FontFamily="{StaticResource FontBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 纸色侧栏：品牌 / 导航 / 运行状态 ================= -->
        <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource BSidebar}"
                BorderBrush="{DynamicResource BSidebarBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel x:Name="BrandPanel" Grid.Row="0" Margin="16,0" LastChildFill="False"
                           VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="{DynamicResource BAccent}"
                            CornerRadius="9" DockPanel.Dock="Left">
                        <TextBlock Text="Q" FontFamily="{StaticResource FontDisplay}" FontSize="15"
                                   FontWeight="Bold" Foreground="{DynamicResource BOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="QuietRemind" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BSidebarStrongText}" />
                        <TextBlock Text="任务提醒" FontSize="10.5" Foreground="{DynamicResource BSidebarText}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                    <Border x:Name="VersionPill" Background="{DynamicResource BSidebarHover}" CornerRadius="6" Padding="6,2"
                            Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BSidebarText}" />
                    </Border>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="Q" FontFamily="{StaticResource FontDisplay}" FontSize="150"
                           FontWeight="Bold" Foreground="{DynamicResource BSidebarStrongText}" Opacity="0.055"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                           IsHitTestVisible="False" />
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <ToggleButton x:Name="TasksRailButton" Style="{StaticResource NavButton}"
                                  IsChecked="True" Click="OnTasksRail" ToolTip="任务列表">
                        <Grid x:Name="NavTasksContent" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Width="17" Height="17" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,4 L4.5,6.5 L8,2.5 M10.5,4 H18 M2,10 L4.5,12.5 L8,8.5 M10.5,10 H18 M2,16 L4.5,18.5 L8,14.5 M10.5,16 H18"
                                  VerticalAlignment="Center" />
                            <TextBlock x:Name="NavTasksText" Grid.Column="1" Text="任务" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="13,0,0,0" />
                        </Grid>
                    </ToggleButton>

                    <ToggleButton x:Name="SettingsRailButton" Style="{StaticResource NavToggleButton}"
                                  Click="OnToggleSettings" ToolTip="设置偏好" Margin="0,2,0,0">
                        <Grid x:Name="NavSettingsContent" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource FontIcon}" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="NavSettingsText" Grid.Column="1" Text="设置" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="13,0,0,0" />
                        </Grid>
                    </ToggleButton>

                    <Border x:Name="SidebarQuickAdd" CornerRadius="11"
                            Margin="14,18,14,0" Padding="11,10" Cursor="Hand"
                            BorderBrush="{DynamicResource BSidebarBorder}" BorderThickness="1"
                            ToolTip="打开快速新增（Ctrl + Alt + N）"
                            MouseLeftButtonUp="OnQuickAddHint">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BSidebarCard}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BSidebarCardHover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE765;" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                           Foreground="{DynamicResource BSidebarActiveText}" VerticalAlignment="Center" />
                                <TextBlock Text="快速新增" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BSidebarStrongText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Ctrl + Alt + N" FontSize="9.5" Foreground="{DynamicResource BSidebarFaint}"
                                       Margin="19,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="14,0,14,16">
                    <Border x:Name="SidebarStatusCard" Background="{DynamicResource BSidebarCard}" CornerRadius="11"
                            BorderBrush="{DynamicResource BSidebarBorder}" BorderThickness="1"
                            Padding="11,10" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource BSuccess}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDiagnosticsWarning}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource BAmber}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="运行状态" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BSidebarText}" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding DiagnosticsSummary}" FontSize="10.5"
                                       Foreground="{DynamicResource BSidebarStrongText}" TextWrapping="Wrap" LineHeight="15"
                                       Margin="0,6,0,0" MaxHeight="46" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SidebarFooterText" Text="v1.0 · 本地优先 · 无联网"
                               FontSize="9.5" Foreground="{DynamicResource BSidebarFaint}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 顶部工作台栏 ================= -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BCanvas}"
                BorderBrush="{DynamicResource BHairlineSoft}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="30,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource BAmber}" VerticalAlignment="Center" />
                    <TextBlock Text="工作台" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BInkSoft}" Margin="8,0,0,0" />
                    <TextBlock Text="/" FontSize="11.5" Foreground="{DynamicResource BFaint}" Margin="7,0" />
                    <TextBlock Text="任务" FontSize="11.5" Foreground="{DynamicResource BFaint}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource BSuccess}" VerticalAlignment="Center" />
                        <TextBlock Text="本地存储 · 无联网" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BFaint}" Margin="7,0,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource CaptionButton}" Height="56" Width="46"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="最小化" ToolTip="最小化" Click="OnMinimize">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource FontIcon}" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Height="56" Width="46"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="最大化或还原" ToolTip="最大化 / 还原" Click="OnToggleMaximize">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource FontIcon}" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Height="56" Width="46"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="关闭到托盘" ToolTip="关闭（最小化到托盘）" Click="OnCloseToTray">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcon}" FontSize="10" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= 工作区：任务 + 设置检查器 ================= -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SettingsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
                <Grid x:Name="PageContent" Margin="34,26,34,24" MinHeight="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页面标题 -->
                <Grid Grid.Row="0" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TODAY'S FOCUS" Style="{StaticResource OverlineText}" />
                        <TextBlock Text="任务" Style="{StaticResource DisplayTitle}" FontSize="32" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource BodyMuted}" />
                            <TextBlock Text="·" Style="{StaticResource BodyMuted}" Margin="8,0" />
                            <TextBlock Text="{Binding PendingCountText}" Style="{StaticResource BodyMuted}"
                                       Foreground="{DynamicResource BAccent}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40"
                            Command="{Binding AddCommand}" VerticalAlignment="Center" Padding="17,0"
                            AutomationProperties.Name="新增任务">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="新增任务" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 概览卡：三个独立指标，避免一条横条压扁信息 -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTileAmber}" Width="38" Height="38">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource FontIcon}" FontSize="16"
                                           Foreground="{DynamicResource BAmber}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="今日待处理" Style="{StaticResource OverlineText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding TodayPendingNumber}" Style="{StaticResource MetricNumber}"
                                               Foreground="{DynamicResource BAccent}" />
                                    <TextBlock Text="项" FontSize="11" Foreground="{DynamicResource BFaint}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatCard}" Margin="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="38" Height="38">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource FontIcon}" FontSize="16"
                                           Foreground="{DynamicResource BAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="启用任务" Style="{StaticResource OverlineText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding EnabledTaskCountText}" Style="{StaticResource MetricNumber}" />
                                    <TextBlock Text="个" FontSize="11" Foreground="{DynamicResource BFaint}"
                                               VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatCard}" Margin="6,0,0,0" Background="{DynamicResource BSurfaceAlt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTileAmber}" Width="38" Height="38">
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource FontIcon}" FontSize="16"
                                           Foreground="{DynamicResource BAmber}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="下一次提醒" Style="{StaticResource OverlineText}" />
                                <TextBlock Text="{Binding NextReminderTimeText}" FontFamily="{StaticResource FontNumeric}"
                                           FontSize="21" FontWeight="SemiBold" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource BAmber}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NextReminderTimeText}" Value="—">
                                                    <Setter Property="Foreground" Value="{DynamicResource BFaint}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NextReminderTimeText}" Value="待处理">
                                                    <Setter Property="Foreground" Value="{DynamicResource BAmberHover}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding NextReminderTaskText}" FontSize="10.5"
                                           Foreground="{DynamicResource BFaint}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 运行状态警示条：只有诊断异常时出现 -->
                <Border Grid.Row="2" Style="{StaticResource WarningBanner}" Margin="0,0,0,14"
                        Visibility="{Binding HasDiagnosticsWarning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="15"
                                   Foreground="{DynamicResource BAmber}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="运行状态需要关注" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BAmberHover}" />
                            <TextBlock Text="{Binding DiagnosticsSummary}" FontSize="11"
                                       Foreground="{DynamicResource BAmber}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="查看日志"
                                Command="{Binding OpenLogCommand}" Height="28" Padding="9,0"
                                Foreground="{DynamicResource BAmberHover}" />
                    </Grid>
                </Border>

                <!-- 任务列表 -->
                <Grid Grid.Row="3">
                    <Border Style="{StaticResource TableCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource BSurfaceAlt}" BorderBrush="{DynamicResource BHairline}"
                                    BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.9*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.85*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="任务内容" Margin="18,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="循环规则" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="下次提醒" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="状态" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="操作" Margin="0,0,18,0"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" BorderBrush="{DynamicResource BHairlineSoft}"
                                                    BorderThickness="0,0,0,1" Background="Transparent">
                                                <Grid Height="64">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*" />
                                                        <ColumnDefinition Width="1.35*" />
                                                        <ColumnDefinition Width="1.9*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="1.85*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" Margin="18,0,10,0">
                                                        <Border Width="3" Height="24" CornerRadius="2"
                                                                Background="{DynamicResource BAmber}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Visibility="{Binding IsTodayDue, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding Content}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BInk}" Margin="12,0,0,0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Content}" />
                                                    </Grid>

                                                    <Grid Grid.Column="1" Margin="0,0,10,0" ClipToBounds="True">
                                                        <ContentControl Content="{Binding RuleText}" HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl" BasedOn="{StaticResource PillGreen}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Recurrence}" Value="Weekly">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BInfo}" />
                                                                            <Setter Property="Background" Value="{DynamicResource BInfoSoft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Recurrence}" Value="Monthly">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BAmber}" />
                                                                            <Setter Property="Background" Value="{DynamicResource BAmberSoft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Recurrence}" Value="Once">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
                                                                            <Setter Property="Background" Value="{DynamicResource BTagGrayBg}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Recurrence}" Value="Yearly">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BTagPurpleFg}" />
                                                                            <Setter Property="Background" Value="{DynamicResource BTagPurpleBg}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </Grid>

                                                    <TextBlock Grid.Column="2" Text="{Binding NextRemindText}" Margin="0,0,10,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
                                                                <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTodayDue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource BAccent}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ToggleButton Style="{StaticResource SwitchToggle}"
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      AutomationProperties.Name="启用或停用任务" />
                                                        <TextBlock Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource BFaint}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="启用" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                            <Setter Property="Text" Value="停用" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,14,0">
                                                        <Button Style="{StaticResource RowIconButton}"
                                                                Command="{Binding HistoryCommand}" ToolTip="历史记录"
                                                                AutomationProperties.Name="历史记录">
                                                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource FontIcon}" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource RowIconButton}"
                                                                Command="{Binding EditCommand}" ToolTip="编辑" Margin="5,0,0,0"
                                                                AutomationProperties.Name="编辑任务">
                                                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIcon}" FontSize="13" />
                                                        </Button>
                                                        <Button Style="{StaticResource RowIconDangerButton}"
                                                                Command="{Binding DeleteCommand}" ToolTip="删除" Margin="5,0,0,0"
                                                                AutomationProperties.Name="删除任务">
                                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIcon}" FontSize="13" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource BSurfaceAlt}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 空状态：由图标底座、同心圆和双行文案组成，避免只有一行灰字 -->
                            <Grid Grid.Row="1" Panel.ZIndex="10"
                                  Visibility="{Binding HasNoTask, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                                    <Grid Width="132" Height="132" HorizontalAlignment="Center">
                                        <Ellipse Width="132" Height="132" Stroke="{DynamicResource BHairlineSoft}"
                                                 StrokeThickness="1" />
                                        <Ellipse Width="96" Height="96" Stroke="{DynamicResource BHairline}"
                                                 StrokeThickness="1" />
                                        <Border Width="54" Height="54" CornerRadius="17"
                                                Background="{DynamicResource BAccentSoft}" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource FontIcon}" FontSize="21"
                                                       Foreground="{DynamicResource BAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BAmber}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
                                    </Grid>
                                    <TextBlock Text="还没有任务" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BInk}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                    <TextBlock Text="把重要的事放在正确的时间，剩下的交给它安静提醒"
                                               Style="{StaticResource BodyMuted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                    <Button Content="创建第一条提醒" Style="{StaticResource PrimaryButton}" Height="34"
                                            Command="{Binding AddCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                            Padding="15,0" />
                                    <TextBlock Text="或按 Ctrl + Alt + N 快速新增" FontSize="10.5"
                                               Foreground="{DynamicResource BFaint}" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Background="{DynamicResource BSurfaceAlt}"
                                    BorderBrush="{DynamicResource BHairline}" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,16,16" Padding="18,0">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource BSuccess}" />
                                        <TextBlock Text="{Binding TaskCountText}" FontSize="10.5"
                                                   Foreground="{DynamicResource BFaint}" Margin="7,0,0,0" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="所有更改即时保存" FontSize="10.5"
                                                   Foreground="{DynamicResource BFaint}" />
                                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource BHairline}" Margin="7,0" />
                                        <TextBlock Text="Ctrl + Alt + N 快速新增" FontSize="10.5"
                                                   Foreground="{DynamicResource BFaint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 删除撤销条 -->
                    <Border Panel.ZIndex="30" Background="{DynamicResource BInk}" CornerRadius="11"
                            Padding="16,11" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,46"
                            Visibility="{Binding HasUndoDelete, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource FontIcon}" FontSize="12"
                                       Foreground="{DynamicResource BRailActiveText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UndoDeleteText}" Foreground="{DynamicResource BRailStrongText}" FontSize="12"
                                       VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis"
                                       Margin="9,0,0,0" />
                            <Button Content="撤销" Command="{Binding UndoDeleteCommand}" Click="OnUndoClicked"
                                    Background="Transparent" Foreground="{DynamicResource BRailActiveText}"
                                    BorderThickness="0" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                    Margin="16,0,0,0" Padding="0" />
