<Window x:Class="QuietRemind.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="历史记录"
        Width="860" Height="640" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BCanvas}" Foreground="{DynamicResource BInk}"
        FontFamily="{StaticResource FontBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="8"
                            GlassFrameThickness="1" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Background="{DynamicResource BSurface}" BorderBrush="{DynamicResource BHairline}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding TitleText}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource BInkSoft}" VerticalAlignment="Center" Margin="20,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="700" />
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Height="52" Width="48"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭历史记录" Click="OnClose" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcon}" FontSize="10" />
                </Button>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="1" Margin="30,24,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HISTORY" Style="{StaticResource OverlineText}" />
                    <TextBlock Text="历史记录" Style="{StaticResource DisplayTitle}" FontSize="28" Margin="0,4,0,0" />
                    <TextBlock Text="实例的计划、处理与推迟记录，只读可追溯" Style="{StaticResource BodyMuted}"
                               Margin="0,5,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource BAccentSoft}" CornerRadius="999"
                        Padding="11,5" VerticalAlignment="Top" Margin="0,7,0,0">
                    <TextBlock Text="{Binding SummaryText}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BAccent}" />
                </Border>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource TableCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource BSurfaceAlt}" BorderBrush="{DynamicResource BHairline}"
                            BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="2.9*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="计划时刻" Margin="20,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="状态" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="处理时间" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="备注" Margin="0,0,20,0" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderBrush="{DynamicResource BHairlineSoft}"
                                            BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid Height="52">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="2.9*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource TableCellText}"
                                                       Text="{Binding PlannedText}" Margin="20,0" />

                                            <Grid Grid.Column="1" Margin="0,0,10,0" ClipToBounds="True">
                                                <ContentControl Content="{Binding StateText}" HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource PillGreen}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BSuccess}" />
                                                                    <Setter Property="Background" Value="{DynamicResource BSuccessSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
                                                                    <Setter Property="Background" Value="{DynamicResource BTagGrayBg}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Missed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BDanger}" />
                                                                    <Setter Property="Background" Value="{DynamicResource BDangerSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Pending">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BAmber}" />
                                                                    <Setter Property="Background" Value="{DynamicResource BAmberSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Grid>

                                            <TextBlock Grid.Column="2" Style="{StaticResource TableCellText}"
                                                       Text="{Binding SettledText}" Margin="0,0,10,0" />

                                            <TextBlock Grid.Column="3" Style="{StaticResource TableCellText}"
                                                       Foreground="{DynamicResource BMuted}" Text="{Binding NoteText}"
                                                       Margin="0,0,20,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding NoteText}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BSurfaceAlt}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <Grid Grid.Row="1" Panel.ZIndex="10"
                          Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="110" Height="110" HorizontalAlignment="Center">
                                <Ellipse Width="110" Height="110" Stroke="{DynamicResource BHairline}" StrokeThickness="1" />
                                <Ellipse Width="78" Height="78" Stroke="{DynamicResource BHairlineSoft}" StrokeThickness="1" />
                                <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource BAccentSoft}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource FontIcon}" FontSize="18"
                                               Foreground="{DynamicResource BAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="该任务暂无历史记录" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BInk}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="任务到点并处理后，记录会出现在这里" Style="{StaticResource BodyMuted}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 底栏 -->
                    <Border Grid.Row="2" Background="{DynamicResource BSurfaceAlt}"
                            BorderBrush="{DynamicResource BHairline}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,16,16" Padding="20,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource BSuccess}" />
                                <TextBlock Text="只读记录 · 不会被清理" FontSize="10.5"
                                           Foreground="{DynamicResource BFaint}" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="最多显示最近 200 条" FontSize="10.5"
                                       Foreground="{DynamicResource BFaint}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
