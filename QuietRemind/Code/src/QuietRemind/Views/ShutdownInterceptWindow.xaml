<Window x:Class="QuietRemind.Views.ShutdownInterceptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关机前提醒"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStyle="None"
        Background="{DynamicResource BSurface}"
        Foreground="{DynamicResource BInk}"
        FontFamily="{StaticResource FontBody}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="1"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Background="{DynamicResource BSurface}" BorderBrush="{DynamicResource BHairline}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="22" Height="22" Background="{DynamicResource BAmberSoft}" CornerRadius="7">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                   Foreground="{DynamicResource BAmber}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="关机前提醒" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BInkSoft}" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}" Height="52" Width="48"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="取消关机" Click="OnCloseCaption" ToolTip="取消关机">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcon}" FontSize="10" />
                </Button>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <StackPanel Grid.Row="1" Margin="28,24,28,10">
            <Grid>
                <TextBlock Text="SHUTDOWN CHECK" Style="{StaticResource OverlineText}" />
                <Border HorizontalAlignment="Right" Background="{DynamicResource BAmberSoft}" CornerRadius="999"
                        Padding="9,3">
                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} 条待处理}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource BAmber}" />
                </Border>
            </Grid>
            <TextBlock Text="还有任务未处理" Style="{StaticResource DisplayTitle}" FontSize="26" Margin="0,5,0,0" />
            <TextBlock Text="以下任务将在本次关机后错过，是否现在返回桌面处理？"
                       Style="{StaticResource BodyMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <Border Style="{StaticResource WarningBanner}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="13"
                               Foreground="{DynamicResource BAmber}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource BAmber}"
                               TextWrapping="Wrap" LineHeight="18"
                               Text="若选择【取消关机】，处理完成后可再次关机，届时不再拦截。" />
                </Grid>
            </Border>

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BSurfaceAlt}" BorderBrush="{DynamicResource BHairlineSoft}"
                                    BorderThickness="1" CornerRadius="11" Padding="14,11" Margin="0,0,0,7">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource BAmberSoft}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource FontIcon}" FontSize="10"
                                                       Foreground="{DynamicResource BAmber}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Content}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BInk}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="360" />
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                               FontFamily="{StaticResource FontNumeric}" FontSize="11.5"
                                               Foreground="{DynamicResource BAmber}" VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- 决策区 -->
        <Border Grid.Row="2" Background="{DynamicResource BSurfaceAlt}"
                BorderBrush="{DynamicResource BHairline}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="关闭窗口等同于取消关机" FontSize="10.5" Foreground="{DynamicResource BFaint}"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="仍要关机" Width="112" Height="38" Style="{StaticResource SecondaryButton}"
                            Click="OnProceedShutdown" />
                    <Button Content="取消关机，返回处理" Width="182" Height="38" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" Click="OnCancelShutdown" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
