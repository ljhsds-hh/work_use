<hc:Window x:Class="QuietRemind.Views.ShutdownInterceptWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          Title="关机前提醒"
          Width="500" SizeToContent="Height"
          WindowStartupLocation="CenterScreen"
          ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="24">
        <TextBlock Text="关机前提醒" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="检测到以下任务将在关机后错过，是否现在处理？"
                   TextWrapping="Wrap" Margin="0,12,0,0" />
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#223478F6" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4">
                        <DockPanel>
                            <TextBlock Text="{Binding TimeText}" Foreground="#FF808080"
                                       DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,0,10,0" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="若选择【取消关机】，返回桌面处理任务后再次关机即可正常放行。"
                   Foreground="#FF808080" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="取消关机" Style="{StaticResource ButtonPrimary}" Width="128" Height="34" Click="OnCancelShutdown" />
            <Button Content="仍要关机" Width="128" Height="34" Margin="16,0,0,0" Click="OnProceedShutdown" />
        </StackPanel>
    </StackPanel>
</hc:Window>
