<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuietRemind</RootNamespace>
    <AssemblyName>QuietRemind</AssemblyName>
    <Version>1.0.0</Version>
    <Description>QuietRemind 任务提醒工具</Description>
    <!-- 单文件独立发布参数（Release 配置生效）：win-x64 免安装单文件 EXE -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 单文件内压缩运行时程序集，体积约减半（少量启动解压开销，可接受） -->
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- 仅保留所需语言资源，减小单文件体积 -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI 组件库：HandyControl（需求强制规范） -->
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <!-- 计划任务注册（进程守护，需求第 7 章）：Task Scheduler Managed Wrapper（新包 ID） -->
    <PackageReference Include="TaskScheduler" Version="2.12.0" />
    <!-- 托盘图标（需求 6.2.4：HandyControl 未覆盖，允许成熟第三方方案） -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <!-- 托盘图标加载 System.Drawing.Icon 所需 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用图标：窗口/任务栏/EXE 共用 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
