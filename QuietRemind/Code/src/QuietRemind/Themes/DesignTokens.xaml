<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         QuietRemind 设计令牌（对齐 主页.html :root 设计规范）
         ============================================================ -->

    <!-- 色板 -->
    <Color x:Key="CPrimary">#2563EB</Color>
    <Color x:Key="CPrimaryHover">#1D4ED8</Color>
    <Color x:Key="CPrimaryLight">#EFF6FF</Color>
    <Color x:Key="CBgPage">#F1F5F9</Color>
    <Color x:Key="CBgCard">#FFFFFF</Color>
    <Color x:Key="CBorder">#E2E8F0</Color>
    <Color x:Key="CTextMain">#0F172A</Color>
    <Color x:Key="CTextSub">#64748B</Color>
    <Color x:Key="CTextMuted">#94A3B8</Color>
    <Color x:Key="CDanger">#EF4444</Color>
    <Color x:Key="CSuccess">#10B981</Color>

    <SolidColorBrush x:Key="BPrimary" Color="#2563EB" />
    <SolidColorBrush x:Key="BPrimaryHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="BPrimaryLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="BBgPage" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BBgCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BBgSubtle" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BBorder" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BRowLine" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BTextMain" Color="#0F172A" />
    <SolidColorBrush x:Key="BTextSub" Color="#64748B" />
    <SolidColorBrush x:Key="BTextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="BDanger" Color="#EF4444" />
    <SolidColorBrush x:Key="BTrackOff" Color="#CBD5E1" />

    <!-- 标签徽标配色（循环规则 / 状态） -->
    <SolidColorBrush x:Key="BTagBlueFg" Color="#2563EB" />
    <SolidColorBrush x:Key="BTagBlueBg" Color="#EFF6FF" />
    <SolidColorBrush x:Key="BTagGreenFg" Color="#059669" />
    <SolidColorBrush x:Key="BTagGreenBg" Color="#ECFDF5" />
    <SolidColorBrush x:Key="BTagOrangeFg" Color="#EA580C" />
    <SolidColorBrush x:Key="BTagOrangeBg" Color="#FFF7ED" />
    <SolidColorBrush x:Key="BTagGrayFg" Color="#64748B" />
    <SolidColorBrush x:Key="BTagGrayBg" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BTagRedFg" Color="#EF4444" />
    <SolidColorBrush x:Key="BTagRedBg" Color="#FEF2F2" />

    <!-- 圆角 -->
    <CornerRadius x:Key="RSm">6</CornerRadius>
    <CornerRadius x:Key="RMd">10</CornerRadius>
    <CornerRadius x:Key="RLg">16</CornerRadius>

    <!-- ============================================================
         通用控件样式
         ============================================================ -->

    <!-- 主操作按钮（完成 / 新增任务） -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#2563EB" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1D4ED8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 弱化操作按钮（跳过） -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="#EF4444" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 稍后提醒分段按钮（btn-group 内单项） -->
    <Style x:Key="GroupSegmentButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FFFFFF" />
                            <Setter Property="Foreground" Value="#0F172A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段按钮组容器（末项无右边线由 ItemContainerStyle 处理，这里提供组外壳） -->
    <Style x:Key="ButtonGroupBorder" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 开关（38×20 滑轨，对应 HTML .switch） -->
    <Style x:Key="SwitchToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="10" Background="#CBD5E1" />
                        <Ellipse x:Name="Dot" Width="16" Height="16" Fill="White"
                                 HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                            <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Dot" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标签徽章（tag-badge）：默认蓝，配绿/橙/灰/红变体 -->
    <Style x:Key="TagBadge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#2563EB" />
        <Setter Property="Background" Value="#EFF6FF" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="TagBadgeGreen" TargetType="TextBlock" BasedOn="{StaticResource TagBadge}">
        <Setter Property="Foreground" Value="#059669" />
        <Setter Property="Background" Value="#ECFDF5" />
    </Style>
    <Style x:Key="TagBadgeOrange" TargetType="TextBlock" BasedOn="{StaticResource TagBadge}">
        <Setter Property="Foreground" Value="#EA580C" />
        <Setter Property="Background" Value="#FFF7ED" />
    </Style>
    <Style x:Key="TagBadgeGray" TargetType="TextBlock" BasedOn="{StaticResource TagBadge}">
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Background" Value="#F1F5F9" />
    </Style>
    <Style x:Key="TagBadgeRed" TargetType="TextBlock" BasedOn="{StaticResource TagBadge}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#EF4444" />
        <Setter Property="Background" Value="#FEF2F2" />
    </Style>

    <!-- 计数胶囊（count-badge） -->
    <Style x:Key="CountBadge" TargetType="Border">
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 操作文字链接（编辑 / 删除） -->
    <Style x:Key="ActionLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Content}"
                               Foreground="#2563EB" VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ActionLinkDanger" TargetType="Button" BasedOn="{StaticResource ActionLinkButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Content}"
                               Foreground="#EF4444" VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 提示盒（alert-box） -->
    <Style x:Key="AlertBox" TargetType="Border">
        <Setter Property="Background" Value="#EFF6FF" />
        <Setter Property="BorderBrush" Value="#2563EB" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="0,6,6,0" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- 设置卡（setting-card） -->
    <Style x:Key="SettingCard" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- 间隔输入框（input-box：白底 + 数字 + “分”） -->
    <Style x:Key="IntervalBox" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="IntervalTextBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 卡片表格容器（table-card） -->
    <Style x:Key="TableCard" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                  Opacity="0.05" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表头单元格 / 行单元格文本 -->
    <Style x:Key="TableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TableCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
