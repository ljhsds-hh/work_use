        <Setter Property="Background" Value="{DynamicResource BAmberSoft}" />
    </Style>
    <Style x:Key="IconTileNeutral" TargetType="Border" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{DynamicResource BSurfaceAlt}" />
    </Style>

    <!-- 区块标题：小号全大写 + 发丝线，避免设置面板只用空白分隔 -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BHairlineSoft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0,0,0" />
    </Style>

    <!-- 提示 / 错误 / 成功条 -->
    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BAmberSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BWarningLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="13,10" />
    </Style>
    <Style x:Key="ErrorBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BDangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BErrorLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="13,10" />
    </Style>
    <Style x:Key="SuccessBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BSuccessSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BSuccessLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="13,10" />
    </Style>

    <!-- 工具提示：与深色侧栏同一材质 -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource BOnDark}" />
        <Setter Property="Background" Value="{DynamicResource BRail}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
