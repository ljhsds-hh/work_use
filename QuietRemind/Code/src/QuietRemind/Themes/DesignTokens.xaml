<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- ============================================================
         QuietRemind · Atelier 设计系统
         方向：暖纸画布 + 墨色文字 + 深松绿主色 + 琥珀时间强调
         原则：发丝线、克制阴影、清晰层级、紧凑但不拥挤
         ============================================================ -->

    <!-- 字体：优先 Win11 可变字体，旧系统自动回退；数字使用窄体提升“仪表感” -->
    <FontFamily x:Key="FontBody">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontNumeric">Bahnschrift, Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe MDL2 Assets</FontFamily>

    <!-- 色板：暖纸画布 + 墨绿主色 + 琥珀时间强调；灰阶均按 WCAG AA 小字号对比度校准 -->
    <Color x:Key="CInk">#18211D</Color>
    <Color x:Key="CInkSoft">#3C4742</Color>
    <Color x:Key="CMuted">#55615B</Color>
    <Color x:Key="CFaint">#66716B</Color>
    <Color x:Key="CCanvas">#F6F3EC</Color>
    <Color x:Key="CSurface">#FFFDF9</Color>
    <Color x:Key="CSurfaceAlt">#FAF7F0</Color>
    <Color x:Key="CSegmentTrack">#EFEAE0</Color>
    <Color x:Key="CHairline">#E4DED2</Color>
    <Color x:Key="CHairlineSoft">#F0EBE2</Color>
    <Color x:Key="CAccent">#1D5B4E</Color>
    <Color x:Key="CAccentHover">#16493E</Color>
    <Color x:Key="CAccentSoft">#E7F1EC</Color>
    <Color x:Key="CAmber">#A9570F</Color>
    <Color x:Key="CAmberHover">#8A430A</Color>
    <Color x:Key="CAmberSoft">#FBF1E1</Color>
    <Color x:Key="CDanger">#B42318</Color>
    <Color x:Key="CDangerSoft">#FDF0EF</Color>
    <Color x:Key="CSuccess">#2F7D5A</Color>
    <Color x:Key="CSuccessSoft">#E9F4EE</Color>
    <Color x:Key="CInfo">#2B5F86</Color>
    <Color x:Key="CInfoSoft">#E9F1F7</Color>
    <Color x:Key="CRail">#101916</Color>
    <Color x:Key="CRailHover">#1A2621</Color>
    <Color x:Key="CRailActive">#22322B</Color>
    <Color x:Key="CRailText">#9CAEA5</Color>
    <Color x:Key="CRailActiveText">#E9BE8B</Color>

    <SolidColorBrush x:Key="BInk" Color="{StaticResource CInk}" />
    <SolidColorBrush x:Key="BInkSoft" Color="{StaticResource CInkSoft}" />
    <SolidColorBrush x:Key="BMuted" Color="{StaticResource CMuted}" />
    <SolidColorBrush x:Key="BFaint" Color="{StaticResource CFaint}" />
    <SolidColorBrush x:Key="BCanvas" Color="{StaticResource CCanvas}" />
    <SolidColorBrush x:Key="BSurface" Color="{StaticResource CSurface}" />
    <SolidColorBrush x:Key="BSurfaceAlt" Color="{StaticResource CSurfaceAlt}" />
    <SolidColorBrush x:Key="BSegmentTrack" Color="{StaticResource CSegmentTrack}" />
    <SolidColorBrush x:Key="BHairline" Color="{StaticResource CHairline}" />
    <SolidColorBrush x:Key="BHairlineSoft" Color="{StaticResource CHairlineSoft}" />
    <SolidColorBrush x:Key="BAccent" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="BAccentHover" Color="{StaticResource CAccentHover}" />
    <SolidColorBrush x:Key="BAccentSoft" Color="{StaticResource CAccentSoft}" />
    <SolidColorBrush x:Key="BAmber" Color="{StaticResource CAmber}" />
    <SolidColorBrush x:Key="BAmberHover" Color="{StaticResource CAmberHover}" />
    <SolidColorBrush x:Key="BAmberSoft" Color="{StaticResource CAmberSoft}" />
    <SolidColorBrush x:Key="BDanger" Color="{StaticResource CDanger}" />
    <SolidColorBrush x:Key="BDangerSoft" Color="{StaticResource CDangerSoft}" />
    <SolidColorBrush x:Key="BSuccess" Color="{StaticResource CSuccess}" />
    <SolidColorBrush x:Key="BSuccessSoft" Color="{StaticResource CSuccessSoft}" />
    <SolidColorBrush x:Key="BInfo" Color="{StaticResource CInfo}" />
    <SolidColorBrush x:Key="BInfoSoft" Color="{StaticResource CInfoSoft}" />
    <SolidColorBrush x:Key="BRail" Color="{StaticResource CRail}" />
    <SolidColorBrush x:Key="BRailHover" Color="{StaticResource CRailHover}" />
    <SolidColorBrush x:Key="BRailActive" Color="{StaticResource CRailActive}" />
    <SolidColorBrush x:Key="BRailText" Color="{StaticResource CRailText}" />
    <SolidColorBrush x:Key="BRailActiveText" Color="{StaticResource CRailActiveText}" />

    <!-- 保留旧键名（部分窗口仍引用），统一映射到新色板 -->
    <SolidColorBrush x:Key="BPrimary" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="BPrimaryHover" Color="{StaticResource CAccentHover}" />
    <SolidColorBrush x:Key="BPrimaryLight" Color="{StaticResource CAccentSoft}" />
    <SolidColorBrush x:Key="BBgPage" Color="{StaticResource CCanvas}" />
    <SolidColorBrush x:Key="BBgCard" Color="{StaticResource CSurface}" />
    <SolidColorBrush x:Key="BBgSubtle" Color="{StaticResource CSurfaceAlt}" />
    <SolidColorBrush x:Key="BBorder" Color="{StaticResource CHairline}" />
    <SolidColorBrush x:Key="BRowLine" Color="{StaticResource CHairlineSoft}" />
    <SolidColorBrush x:Key="BTextMain" Color="{StaticResource CInk}" />
    <SolidColorBrush x:Key="BTextSub" Color="{StaticResource CMuted}" />
    <SolidColorBrush x:Key="BTextMuted" Color="{StaticResource CFaint}" />
    <SolidColorBrush x:Key="BTrackOff" Color="#D8D3CA" />
    <SolidColorBrush x:Key="BTagBlueFg" Color="{StaticResource CInfo}" />
    <SolidColorBrush x:Key="BTagBlueBg" Color="{StaticResource CInfoSoft}" />
    <SolidColorBrush x:Key="BTagGreenFg" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="BTagGreenBg" Color="{StaticResource CAccentSoft}" />
    <SolidColorBrush x:Key="BTagOrangeFg" Color="{StaticResource CAmber}" />
    <SolidColorBrush x:Key="BTagOrangeBg" Color="{StaticResource CAmberSoft}" />
    <SolidColorBrush x:Key="BTagGrayFg" Color="{StaticResource CMuted}" />
    <SolidColorBrush x:Key="BTagGrayBg" Color="#F1EFEA" />
    <SolidColorBrush x:Key="BTagRedFg" Color="{StaticResource CDanger}" />
    <SolidColorBrush x:Key="BTagRedBg" Color="{StaticResource CDangerSoft}" />
    <SolidColorBrush x:Key="BTagPurpleFg" Color="#6B4E8E" />
    <SolidColorBrush x:Key="BTagPurpleBg" Color="#F3EEF8" />

    <!-- 覆盖 HandyControl 主题主色，使输入框焦点、日期/时间选择、数值控件与自有色板一致 -->
    <Color x:Key="PrimaryColor">#1D5B4E</Color>
    <Color x:Key="LightPrimaryColor">#E7F1EC</Color>
    <Color x:Key="DarkPrimaryColor">#16493E</Color>
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#A9570F</Color>
    <Color x:Key="BorderColor">#E4DED2</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource CAccent}" />
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource CAccentSoft}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource CAccentHover}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CAccent}" />

    <!-- 主题化语义键：浅色为温和纸感，深色由 ThemeService 统一改写为墨夜配色 -->
    <SolidColorBrush x:Key="BOnAccent" Color="White" />
    <SolidColorBrush x:Key="BOnDark" Color="#F1F4F2" />
    <SolidColorBrush x:Key="BSwitchThumb" Color="White" />
    <SolidColorBrush x:Key="BSegmentThumb" Color="#FFFDF9" />
    <SolidColorBrush x:Key="BGhostBorder" Color="#D5D0C7" />
    <SolidColorBrush x:Key="BGhostHover" Color="#EDEAE3" />
    <SolidColorBrush x:Key="BGhostPressed" Color="#E2DED5" />
    <SolidColorBrush x:Key="BDangerHover" Color="#8F1D14" />
    <SolidColorBrush x:Key="BDarkButtonText" Color="#E7EFEA" />
    <SolidColorBrush x:Key="BDarkButtonHover" Color="#0F1513" />
    <!-- 侧栏：与主画布同源的纸色，深色模式下为略亮的墨层 -->
    <SolidColorBrush x:Key="BSidebar" Color="#F1EDE4" />
    <SolidColorBrush x:Key="BSidebarCard" Color="#FFFDF9" />
    <SolidColorBrush x:Key="BSidebarCardHover" Color="#F8F4EB" />
    <SolidColorBrush x:Key="BSidebarBorder" Color="#E1DBCF" />
    <SolidColorBrush x:Key="BSidebarText" Color="#55615B" />
    <SolidColorBrush x:Key="BSidebarStrongText" Color="#18211D" />
    <SolidColorBrush x:Key="BSidebarFaint" Color="#848074" />
    <SolidColorBrush x:Key="BSidebarHover" Color="#EAE5DA" />
    <SolidColorBrush x:Key="BSidebarActive" Color="#E4EDE7" />
    <SolidColorBrush x:Key="BSidebarActiveText" Color="#1D5B4E" />

    <SolidColorBrush x:Key="BRailSurface" Color="#17221E" />
    <SolidColorBrush x:Key="BRailSurfaceHover" Color="#1D2C25" />
    <SolidColorBrush x:Key="BRailTextHover" Color="#DCE6E1" />
    <SolidColorBrush x:Key="BRailStrongText" Color="#E9EFEA" />
    <SolidColorBrush x:Key="BRailFaint" Color="#71857B" />
    <SolidColorBrush x:Key="BBrandMarkInk" Color="#17231E" />
    <SolidColorBrush x:Key="BWarningLine" Color="#EAD7B9" />
    <SolidColorBrush x:Key="BErrorLine" Color="#F1CCC8" />
    <SolidColorBrush x:Key="BSuccessLine" Color="#CDE7D8" />
    <SolidColorBrush x:Key="BOverlayBase" Color="#0B0F14" />

    <!-- 圆角 -->
    <CornerRadius x:Key="RSm">6</CornerRadius>
    <CornerRadius x:Key="RMd">10</CornerRadius>
    <CornerRadius x:Key="RLg">14</CornerRadius>

    <!-- ============================================================
         文本层级
         ============================================================ -->
    <Style x:Key="DisplayTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BInk}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BInk}" />
    </Style>
    <Style x:Key="OverlineText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BFaint}" />
    </Style>
    <Style x:Key="BodyMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="MetricNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontNumeric}" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BInk}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BInkSoft}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource BFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 键盘焦点：所有自绘按钮共用，避免只依赖鼠标 hover -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource BAccent}" BorderThickness="2"
                            CornerRadius="10" Margin="-3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusVisualDark">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource BRailActiveText}" BorderThickness="2"
                            CornerRadius="12" Margin="-3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource BAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BOnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource BSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource BInkSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BHairline}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BSurfaceAlt}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BGhostBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BSurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource BInkSoft}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行内图标按钮（历史/编辑/删除） -->
    <Style x:Key="RowIconButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontIcon}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BSurfaceAlt}" />
                            <Setter Property="Foreground" Value="{DynamicResource BInk}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RowIconDangerButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BDangerSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource BDanger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionLinkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ActionLinkDanger" TargetType="Button" BasedOn="{StaticResource ActionLinkButton}">
        <Setter Property="Foreground" Value="{DynamicResource BDanger}" />
    </Style>

    <!-- 标题栏控制按钮 -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BGhostHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BInk}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BGhostPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BDanger}" />
                            <Setter Property="Foreground" Value="{DynamicResource BOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BDangerHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 深色标题栏（主窗口） -->
    <Style x:Key="CaptionButtonDark" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BRailText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BRailHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BDarkButtonText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BDarkButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CaptionCloseDark" TargetType="Button" BasedOn="{StaticResource CaptionButtonDark}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BDanger}" />
                            <Setter Property="Foreground" Value="{DynamicResource BOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BDangerHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource BOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入控件
         ============================================================ -->
    <Style x:Key="FieldTextBox" TargetType="hc:TextBox" BasedOn="{StaticResource {x:Type hc:TextBox}}">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
