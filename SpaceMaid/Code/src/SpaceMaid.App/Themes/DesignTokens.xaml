<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!--
      SpaceMaid 设计令牌（唯一来源）。
      规则：界面一律引用这里的 key，禁止逐处硬编码颜色/字号/间距。
      颜色一律复用 HandyControl 语义色（DangerBrush / SecondaryTextBrush），不自定义色值，保证皮肤一致性。
    -->

    <!-- 字号 -->
    <sys:Double x:Key="SmFontSizeTitle">20</sys:Double>
    <sys:Double x:Key="SmFontSizeSection">15</sys:Double>
    <sys:Double x:Key="SmFontSizeBody">13</sys:Double>
    <sys:Double x:Key="SmFontSizeCaption">12</sys:Double>

    <!-- 间距 -->
    <Thickness x:Key="SmPagePadding">24</Thickness>
    <Thickness x:Key="SmCardPadding">20</Thickness>
    <Thickness x:Key="SmItemPadding">12,8</Thickness>

    <!-- 文案样式 -->
    <Style x:Key="SmTextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SmTextCaption" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <!-- 需求 5.4：风险文案用红色文字做单点强调（不做大面积色块） -->
    <Style x:Key="SmTextDanger" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SmTextTitle" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SmTextSection" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
