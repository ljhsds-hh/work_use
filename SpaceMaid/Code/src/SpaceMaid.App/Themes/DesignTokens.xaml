<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:helpers="clr-namespace:SpaceMaid.App.Helpers">

    <!--
      ═══════════════════════════════════════════════════════════════════════════════════
      SpaceMaid 设计系统（需求 5.3-1/5：令牌集中在一处，界面禁止逐处硬编码）
      ═══════════════════════════════════════════════════════════════════════════════════

      分工（改界面之前先看这三条，否则很容易把系统改乱）：

      ① **颜色只来自 HandyControl 皮肤**（SkinDefault.xaml / Theme.xaml，在 App.xaml 里合并）。
         本文件里不出现任何色值，一律 `{DynamicResource <HC 语义色>}`，这样换肤/深色时跟着一起变；
         `StaticSafetyTests.App_xaml_should_not_hardcode_colors` 会拦下任何 `#RRGGBB` / `Color=` /
         `SolidColorBrush` 的写法。
         常用语义色：PrimaryBrush(主色) / DangerBrush(危险) / WarningBrush / SuccessBrush / InfoBrush /
         PrimaryTextBrush(正文) / SecondaryTextBrush(次要) / ThirdlyTextBrush(更弱的元信息) /
         RegionBrush(卡片面) / SecondaryRegionBrush(次级面=导航栏、表头) / BackgroundBrush(窗口底) /
         BorderBrush(描边) / IconBrush(图标) / ReverseTextBrush(反白文字)。
      ② **尺度来自本文件的令牌**：字号走 SmFont*，间距走 SmSpace*，圆角走 SmRadius*，字号↔字重的搭配走 SmText*。
      ③ **交互控件一律 HandyControl**（hc:TextBox / hc:NumericUpDown / hc:ToggleBlock / hc:TabControl /
         hc:CircleProgressBar / hc:Tag / hc:Divider / hc:ScrollViewer / hc:Empty / hc:Badge / hc:Growl）。
         HandyControl 3.5.1 **没有** Button / CheckBox / Switch / Expander / ProgressBar，这五类用 WPF 原生控件，
         外观由 HC 皮肤提供的样式（ButtonPrimary / ButtonDefault / ButtonDanger / ButtonTransparent）统一。
         本文件里的模板只做"外观套用"，不造自绘伪控件。
    -->

    <!-- ═══ 字体 ═══ -->
    <FontFamily x:Key="SmFontUi">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="SmFontNumeric">Segoe UI Semibold, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- ═══ 字号（类型刻度 30 / 22 / 16 / 13 / 12 / 11）═══ -->
    <sys:Double x:Key="SmFontSizeDisplay">30</sys:Double>
    <sys:Double x:Key="SmFontSizeMetric">22</sys:Double>
    <sys:Double x:Key="SmFontSizeTitle">16</sys:Double>
    <sys:Double x:Key="SmFontSizeBody">13</sys:Double>
    <sys:Double x:Key="SmFontSizeCaption">12</sys:Double>
    <sys:Double x:Key="SmFontSizeMini">11</sys:Double>
    <!-- 兼容既有 key（旧界面用的是 20/15，这里保持"标题/小节"两级语义不丢） -->
    <sys:Double x:Key="SmFontSizeSection">13</sys:Double>

    <!-- ═══ 间距刻度（4 的倍数，只允许用这几个值）═══ -->
    <sys:Double x:Key="SmSpace1">4</sys:Double>
    <sys:Double x:Key="SmSpace2">8</sys:Double>
    <sys:Double x:Key="SmSpace3">12</sys:Double>
    <sys:Double x:Key="SmSpace4">16</sys:Double>
    <sys:Double x:Key="SmSpace5">20</sys:Double>
    <sys:Double x:Key="SmSpace6">24</sys:Double>
    <sys:Double x:Key="SmSpace8">32</sys:Double>

    <Thickness x:Key="SmPagePadding">20</Thickness>
    <Thickness x:Key="SmCardPadding">18</Thickness>
    <Thickness x:Key="SmCardMargin">0,0,0,12</Thickness>
    <Thickness x:Key="SmItemPadding">14,12</Thickness>
    <Thickness x:Key="SmItemMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="SmItemSpacing">8</sys:Double>

    <!-- ═══ 圆角 ═══ -->
    <CornerRadius x:Key="SmRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="SmRadiusMd">6</CornerRadius>
    <CornerRadius x:Key="SmRadiusLg">10</CornerRadius>
    <CornerRadius x:Key="SmRadiusPill">999</CornerRadius>

    <!-- ═══ 导航栏尺寸 ═══ -->
    <sys:Double x:Key="SmRailWidth">212</sys:Double>
    <sys:Double x:Key="SmRailItemHeight">40</sys:Double>
    <sys:Double x:Key="SmHeaderHeight">64</sys:Double>
    <sys:Double x:Key="SmIconSize">18</sys:Double>
    <sys:Double x:Key="SmIconSizeSm">14</sys:Double>

    <!--
      ═══ 图标（24×24 网格的填充路径）═══
      为什么自己定义而不是引用 HC 的 Geometry：HC 3.5.1 的几何资源键名不稳定（部分是控件属性而非资源键），
      引用不到时 XAML 会静默变成空白图标，反而更糟。这里是一套自有的、随设计系统版本化的图标集，
      `Path Stretch="Uniform"` 缩放到任意尺寸，颜色由使用处的 SmIcon* 样式决定。
    -->
    <PathGeometry x:Key="SmIconSparkle" FillRule="Nonzero" Figures="M 12 1.6 L 14.35 9.65 L 22.4 12 L 14.35 14.35 L 12 22.4 L 9.65 14.35 L 1.6 12 L 9.65 9.65 Z M 19.2 2.4 L 20.1 5.1 L 22.8 6 L 20.1 6.9 L 19.2 9.6 L 18.3 6.9 L 15.6 6 L 18.3 5.1 Z" />
    <PathGeometry x:Key="SmIconDrive" FillRule="EvenOdd" Figures="M 2.5 5 H 21.5 V 19 H 2.5 Z M 15.2 14 A 1.6 1.6 0 1 1 18.4 14 A 1.6 1.6 0 1 1 15.2 14" />
    <PathGeometry x:Key="SmIconShield" FillRule="EvenOdd" Figures="M 12 2 L 20.5 5.2 V 12.2 C 20.5 16.9 16.8 20.4 12 21.8 C 7.2 20.4 3.5 16.9 3.5 12.2 V 5.2 Z M 8.8 11.9 L 11.1 14.2 L 15.9 9.4 L 17.6 11.1 L 11.1 17.6 L 7.1 13.6 Z" />
    <PathGeometry x:Key="SmIconTune" FillRule="Nonzero" Figures="M 3 6 H 21 V 8.2 H 3 Z M 3 11 H 21 V 13.2 H 3 Z M 3 16 H 21 V 18.2 H 3 Z M 6.4 3.9 H 8.6 V 10.3 H 6.4 Z M 13.6 8.9 H 15.8 V 15.3 H 13.6 Z M 9.4 13.9 H 11.6 V 20.3 H 9.4 Z" />
    <PathGeometry x:Key="SmIconHistory" FillRule="EvenOdd" Figures="M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M 5.9 12 A 6.1 6.1 0 1 1 18.1 12 A 6.1 6.1 0 1 1 5.9 12 Z M 11 7.5 H 13 V 12.6 H 11 Z M 12.2 11.5 H 16.4 V 13.2 H 12.2 Z" />
    <PathGeometry x:Key="SmIconFolder" FillRule="Nonzero" Figures="M 2.5 5.5 H 9.5 L 11.8 8 H 21.5 V 19.5 H 2.5 Z" />
    <PathGeometry x:Key="SmIconRefresh" FillRule="EvenOdd" Figures="M 2.5 12 A 9.5 9.5 0 1 0 21.5 12 A 9.5 9.5 0 1 0 2.5 12 Z M 5.5 12 A 6.5 6.5 0 1 1 18.5 12 A 6.5 6.5 0 1 1 5.5 12 Z M 10.6 1 L 13.4 1 L 12 4.6 Z" />
    <PathGeometry x:Key="SmIconExport" FillRule="Nonzero" Figures="M 11 2.5 H 13 V 8.5 H 16.2 L 12 14 L 7.8 8.5 H 11 Z M 3.5 15.5 H 6.5 V 19 H 17.5 V 15.5 H 20.5 V 21.5 H 3.5 Z" />
    <PathGeometry x:Key="SmIconCheck" FillRule="Nonzero" Figures="M 9.2 16.4 L 4.8 12 L 3.4 13.4 L 9.2 19.2 L 20.6 7.8 L 19.2 6.4 Z" />
    <PathGeometry x:Key="SmIconWarning" FillRule="EvenOdd" Figures="M 12 2.6 L 22.4 20.4 H 1.6 Z M 10.9 8.6 H 13.1 V 14.6 H 10.9 Z M 10.9 16.4 H 13.1 V 18.6 H 10.9 Z" />
    <PathGeometry x:Key="SmIconInfo" FillRule="EvenOdd" Figures="M 2 12 A 10 10 0 1 0 22 12 A 10 10 0 1 0 2 12 Z M 10.9 6.4 H 13.1 V 8.6 H 10.9 Z M 10.9 10.4 H 13.1 V 17.6 H 10.9 Z" />
    <PathGeometry x:Key="SmIconClose" FillRule="Nonzero" Figures="M 5.6 4.2 L 12 10.6 L 18.4 4.2 L 19.8 5.6 L 13.4 12 L 19.8 18.4 L 18.4 19.8 L 12 13.4 L 5.6 19.8 L 4.2 18.4 L 10.6 12 L 4.2 5.6 Z" />
    <PathGeometry x:Key="SmIconChevronRight" FillRule="Nonzero" Figures="M 9.4 4.6 L 16.8 12 L 9.4 19.4 L 7.6 17.6 L 13.2 12 L 7.6 6.4 Z" />
    <PathGeometry x:Key="SmIconChevronDown" FillRule="Nonzero" Figures="M 4.6 9.4 L 12 16.8 L 19.4 9.4 L 17.6 7.6 L 12 13.2 L 6.4 7.6 Z" />
    <PathGeometry x:Key="SmIconTrash" FillRule="EvenOdd" Figures="M 9 3 H 15 L 15.8 5 H 20 V 7 H 4 V 5 H 8.2 Z M 6.2 8.5 H 17.8 L 16.8 21 H 7.2 Z M 10 10.5 H 11.6 V 18.5 H 10 Z M 12.4 10.5 H 14 V 18.5 H 12.4 Z" />
    <PathGeometry x:Key="SmIconStop" FillRule="Nonzero" Figures="M 6 6 H 18 V 18 H 6 Z" />
    <PathGeometry x:Key="SmIconDoc" FillRule="Nonzero" Figures="M 5 2.5 H 13.6 V 8.4 H 19.5 V 21.5 H 5 Z" />
    <PathGeometry x:Key="SmIconLock" FillRule="EvenOdd" Figures="M 5 10 H 19 V 21 H 5 Z M 8 10 V 7.5 A 4 4 0 0 1 16 7.5 V 10 H 13.8 V 7.5 A 1.8 1.8 0 0 0 10.2 7.5 V 10 Z" />

    <!-- ═══ 图标样式 ═══ -->
    <Style x:Key="SmIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="{StaticResource SmIconSize}" />
        <Setter Property="Height" Value="{StaticResource SmIconSize}" />
        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SmIconSm" TargetType="Path" BasedOn="{StaticResource SmIcon}">
        <Setter Property="Width" Value="{StaticResource SmIconSizeSm}" />
        <Setter Property="Height" Value="{StaticResource SmIconSizeSm}" />
    </Style>

    <Style x:Key="SmIconAccent" TargetType="Path" BasedOn="{StaticResource SmIcon}">
        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <Style x:Key="SmIconDanger" TargetType="Path" BasedOn="{StaticResource SmIcon}">
        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="SmIconCaution" TargetType="Path" BasedOn="{StaticResource SmIcon}">
        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style x:Key="SmIconInverse" TargetType="Path" BasedOn="{StaticResource SmIcon}">
        <Setter Property="Fill" Value="{DynamicResource ReverseTextBrush}" />
    </Style>

    <!-- ═══ 文字样式（正文/次要/元信息/标题/主数字）═══ -->

    <Style x:Key="SmTextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmTextCaption" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeCaption}" />
    </Style>

    <!-- 元信息：路径样例、时间戳这类"知道有就行"的内容，最弱一级 -->
    <Style x:Key="SmTextMeta" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeMini}" />
        <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    </Style>

    <!-- 需求 5.4-3/6：风险文案用红色文字单点强调，不做大面积色块 -->
    <Style x:Key="SmTextDanger" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SmTextWarning" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SmTextAccent" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 页面标题 / 卡片标题 / 小节标题 -->
    <Style x:Key="SmTextPageTitle" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeMetric}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SmTextTitle" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SmTextSection" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 分区小标题（导航栏分组、卡片内的小组名）大写间距感 -->
    <Style x:Key="SmTextLabel" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeMini}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
    </Style>

    <!-- 主数字：本次可处理量（需求 5.3-2 要求最显著） -->
    <Style x:Key="SmTextDisplay" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontFamily" Value="{StaticResource SmFontNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- 次级数字：总容量 / 已用 / 可用 -->
    <Style x:Key="SmTextMetric" TargetType="TextBlock" BasedOn="{StaticResource SmTextBody}">
        <Setter Property="FontFamily" Value="{StaticResource SmFontNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- 兼容旧 key：列表里的数字列 -->
    <Style x:Key="SmTextNumber" TargetType="TextBlock" BasedOn="{StaticResource SmTextMetric}">
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- ═══ 面（surface）：卡片 / 次级面板 / 导航栏 / 提示条 ═══ -->

    <!-- 卡片：HandyControl 提供了 hc:Card，这里只统一取值（Padding/Margin）。
         圆角与背景由 HC 的卡片模板给出；需要"贴色块"的地方用下面的 SmPanel* 系列。 -->
    <Style x:Key="SmCard" TargetType="hc:Card">
        <Setter Property="Padding" Value="{StaticResource SmCardPadding}" />
        <Setter Property="Margin" Value="{StaticResource SmCardMargin}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 兼容旧 key -->
    <Style x:Key="SmListCard" TargetType="hc:Card" BasedOn="{StaticResource SmCard}" />

    <!-- 卡片内的次级面板：把一组信息从卡片背景里"托"出来 -->
    <Style x:Key="SmPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SmRadiusMd}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="SmPanelFlat" TargetType="Border" BasedOn="{StaticResource SmPanel}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- 可点击的卡片/行：悬停时换一层底色（行是列表的基本单位） -->
    <Style x:Key="SmRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource SmRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource SmItemPadding}" />
        <Setter Property="Margin" Value="{StaticResource SmItemMargin}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 卡片内的分隔线（比 hc:Divider 更轻，用于密集列表） -->
    <Style x:Key="SmSeparator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Margin" Value="0,10,0,10" />
    </Style>

    <!-- ═══ 状态色标（chip）：安全 / 注意 / 危险 / 主色 / 中性 ═══
         用 hc:Tag（HC 提供的标签控件），背景与前景取 HC 的"浅色/深色"成对语义色：
         Light* 系当底、Dark* 系当字，保证同一个色相、且随皮肤变。 -->
    <Style x:Key="SmChip" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource SmRadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
    </Style>

    <Style x:Key="SmChipSafe" TargetType="Border" BasedOn="{StaticResource SmChip}">
        <Setter Property="Background" Value="{DynamicResource LightSuccessBrush}" />
    </Style>

    <Style x:Key="SmChipAccent" TargetType="Border" BasedOn="{StaticResource SmChip}">
        <Setter Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
    </Style>

    <Style x:Key="SmChipInfo" TargetType="Border" BasedOn="{StaticResource SmChip}">
        <Setter Property="Background" Value="{DynamicResource LightInfoBrush}" />
    </Style>

    <Style x:Key="SmChipCaution" TargetType="Border" BasedOn="{StaticResource SmChip}">
        <Setter Property="Background" Value="{DynamicResource LightWarningBrush}" />
    </Style>

    <Style x:Key="SmChipDanger" TargetType="Border" BasedOn="{StaticResource SmChip}">
        <Setter Property="Background" Value="{DynamicResource LightDangerBrush}" />
    </Style>

    <!-- ═══ 按钮（四级视觉：主 / 次 / 危险 / 幽灵）═══
         HandyControl 3.5.1 **没有 Button 控件**，只提供若干按钮样式；而且样式键名不全可靠
         （实测 `ButtonTransparent` 根本不存在，直接 `BasedOn` 会在启动时抛"找不到资源"）。
         因此按钮外观由本设计系统**自己定义模板**：几何（圆角/内边距/最小高度）与状态
         （悬停/按下/禁用）都在这里统一，颜色仍取 HC 语义色，不出现任何硬编码色值。
         需求 5.3-3 的三级区分靠背景色而不是大面积红绿块：
         主=实心主色、次=白底描边、危险=白底红字红边、幽灵=无边框（卡片内联操作）。 -->
    <Style x:Key="SmButtonPrimary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ReverseTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SmRadiusMd}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DarkPrimaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DarkPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DarkPrimaryBrush}" />
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次操作：重新扫描 / 导出清单 / 设置 -->
    <Style x:Key="SmButtonSecondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmRadiusMd}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵操作：卡片内的"查看 / 打开目录"（无边框，只在悬停时给一层浅底） -->
    <Style x:Key="SmButtonGhost" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SmRadiusSm}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险操作（勾选里可能含 L3 / 回收站时的「清理选中项」）：白底红字红边，克制的红色 -->
    <Style x:Key="SmButtonDanger" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource SmRadiusMd}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LightDangerBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行内链接式按钮（"查看"这类） -->
    <Style x:Key="SmButtonLink" TargetType="Button" BasedOn="{StaticResource SmButtonGhost}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <!-- ═══ 导航项（左侧导航栏）：WPF 原生 RadioButton + 自定义模板 ═══
         HC 3.5.1 的 hc:SideMenu 是"整页宿主"式控件，和这里的单窗口视图切换不是一套模型；
         导航项本身不是"伪控件"——RadioButton 的选中语义刚好是导航的语义，模板只负责外观。 -->
    <Style x:Key="SmNavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Height" Value="{StaticResource SmRailItemHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="10,2,10,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource SmRadiusMd}" />
                        <Border x:Name="Indicator" Width="3" HorizontalAlignment="Left"
                                Margin="0,9,0,9" CornerRadius="{StaticResource SmRadiusSm}"
                                Background="Transparent" />
                        <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RegionBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource LightPrimaryBrush}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 导航项的图标：跟着条目前景色走（选中变蓝） -->
    <Style x:Key="SmNavIcon" TargetType="Path" BasedOn="{StaticResource SmIcon}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    </Style>

    <!-- ═══ 导航栏里的"动作项"（例如「设置」）═══
         「设置」打开的是一个独立窗口，不是本窗的一个页面——所以它不该是一个"选中态"的导航项。
         用 Button 表达"点击即发生动作"，外观与导航项保持一致（同高、同内边距、同图标尺寸），
         语义与可测试性都更准确（UIA 能直接 Invoke，无需模拟鼠标点击）。 -->
    <Style x:Key="SmNavAction" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SmFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{StaticResource SmRailItemHeight}" />
        <Setter Property="Margin" Value="10,2,10,2" />
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource SmRadiusMd}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RegionBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ═══ 进度环（主数字旁边的磁盘占用）═══ -->
    <Style x:Key="SmRing" TargetType="hc:CircleProgressBar">
        <Setter Property="ArcThickness" Value="10" />
        <Setter Property="ShowText" Value="True" />
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="132" />
        <Setter Property="FontFamily" Value="{StaticResource SmFontNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource SmFontSizeMetric}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ═══ 分区卡片头（分级列表的标题行）═══ -->
    <Style x:Key="SmSectionHeader" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SmRadiusMd}" />
    </Style>

    <!-- ═══ 转换器（两个窗口共用，避免各自声明一份）═══ -->
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <helpers:TextToVisibilityConverter x:Key="TextToVisibility" />
    <helpers:CountToVisibilityConverter x:Key="CountToVisibility" />

</ResourceDictionary>
