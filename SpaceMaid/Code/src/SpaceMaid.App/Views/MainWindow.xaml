<Window x:Class="SpaceMaid.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:helpers="clr-namespace:SpaceMaid.App.Helpers"
        xmlns:vm="clr-namespace:SpaceMaid.App.ViewModels"
        Title="SpaceMaid C 盘空间管家"
        Width="1000" Height="720"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <!--
      三段式主窗（需求 5.1）：
      ① 顶部：磁盘总览（环形占用图 + 总容量 / 已用 / 可用 / 本次可处理）
      ② 中部：L1 / L2 / L3 / 回收站 四个 hc:Expander 分组清单
      ③ 底部：重新扫描 / 导出清单 / 清理选中项 / 一键清理（L1）/ 设置
      颜色与字号一律走 Themes/DesignTokens.xaml 的 key；风险红只用 DangerBrush 做文字强调（需求 5.3-3 / 5.4）。
    -->

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <helpers:TextToVisibilityConverter x:Key="TextToVisibility" />
        <helpers:CountToVisibilityConverter x:Key="CountToVisibility" />
    </Window.Resources>

    <Grid>
        <!-- 轻提示层：token 与 App 里的 GrowlNotificationService 配对（构造函数中 Growl.Register） -->
        <StackPanel x:Name="GrowlPanel"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    hc:Growl.Token="SpaceMaidGrowl"
                    hc:Growl.GrowlParent="True" />

        <DockPanel Margin="{StaticResource SmPagePadding}">

            <!-- ① 顶部：磁盘总览 -->
            <hc:Card DockPanel.Dock="Top" Margin="{StaticResource SmCardMargin}" Padding="{StaticResource SmCardPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <hc:CircleProgressBar Grid.Column="0"
                                          Width="118" Height="118"
                                          Margin="0,0,20,0"
                                          Maximum="100"
                                          Value="{Binding UsedPercent100, Mode=OneWay}"
                                          ShowText="True" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmTextTitle}" Text="C 盘空间总览" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextBody}"
                                   Text="{Binding DiskHeadline, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                                   Text="{Binding StartupStatusMessage, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                                   Text="{Binding SameVolumeNotice, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" MinWidth="200" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SmTextCaption}" Text="总容量" />
                        <TextBlock Style="{StaticResource SmTextNumber}" Text="{Binding VolumeTotalText, Mode=OneWay}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextCaption}" Text="已用" />
                        <TextBlock Style="{StaticResource SmTextNumber}" Text="{Binding VolumeUsedText, Mode=OneWay}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextCaption}" Text="可用" />
                        <TextBlock Style="{StaticResource SmTextNumber}" Text="{Binding VolumeFreeText, Mode=OneWay}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextCaption}" Text="本次可处理" />
                        <TextBlock Style="{StaticResource SmTextNumber}" Text="{Binding ProcessableText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </hc:Card>

            <!-- 启动自检 / 权限提示（需求 3.6-2：未提权时明确阻止进入清理流程） -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12,8"
                    Visibility="{Binding IsFlowBlocked, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <hc:Tag Content="需要处理" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource SmTextDanger}" Text="{Binding BlockReason, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ③ 底部：操作栏（先 Dock 底部；中间区域自动填充并滚动） -->
            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel>
                    <hc:Divider Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal">
                        <Button Name="RescanButton" Command="{Binding RescanCommand}" Content="重新扫描" />
                        <Button Name="ExportManifestButton" Margin="8,0,0,0" Command="{Binding ExportManifestCommand}"
                                Content="导出清单" />
                        <Button Name="CleanSelectedButton" Margin="8,0,0,0" Command="{Binding CleanSelectedCommand}"
                                Content="清理选中项" />
                        <Button Name="OneClickCleanButton" Margin="8,0,0,0" Command="{Binding OneClickCleanCommand}"
                                Content="一键清理（L1）" Style="{StaticResource ButtonPrimary}" />
                        <Button Name="SettingsButton" Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}"
                                Content="设置" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource SmTextBody}" Text="{Binding TotalProcessableText, Mode=OneWay}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextCaption}"
                                       Text="{Binding CheckedSummaryText, Mode=OneWay}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextCaption}"
                                       Text="{Binding StatusMessage, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar Height="6" IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                                       Text="{Binding ProgressText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ② 中部：分级清单（可滚动，长任务不冻结界面，需求 5.2-5） -->
            <hc:ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 执行结果页（需求 3.2-4 / 3.9-4：实际效果 + 跳过项 + 可还原项 + 复核入口） -->
                    <hc:Card Margin="{StaticResource SmCardMargin}" Padding="{StaticResource SmCardPadding}"
                             Visibility="{Binding HasExecutionResult, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SmTextSection}" Text="本次执行结果" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextBody}"
                                       Text="{Binding ResultSummaryText, Mode=OneWay}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                                       Text="{Binding ResultDetailText, Mode=OneWay}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextDanger}"
                                       Text="{Binding ReviewHint, Mode=OneWay}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Name="OpenReviewButton" Command="{Binding RunReviewCommand}" Content="查看复核报告" />
                                <Button Margin="8,0,0,0" Command="{Binding OpenReportDirectoryCommand}" Content="打开报告目录" />
                            </StackPanel>
                        </StackPanel>
                    </hc:Card>

                    <!-- 四个分级分组（HandyControl 3.5.1 没有 hc:Expander，用 WPF 原生 Expander；样式由 HC 皮肤统一） -->
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CleanSectionViewModel}">
                                <Expander Margin="0,0,0,10" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SmTextSection}" Text="{Binding Title}" />
                                            <TextBlock Margin="8,0,0,0" Style="{StaticResource SmTextCaption}"
                                                       Text="{Binding CountText}" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SmTextCaption}" Text="{Binding Hint}" />

                                        <!-- 全选 / 反选只作用于当前分级（需求 3.3-3） -->
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal"
                                                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                            <Button Command="{Binding DataContext.ToggleAllCurrentCategoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Content="全选/反选本分级" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Style="{StaticResource SmTextCaption}"
                                                       Text="（只影响本分级，不提供一键全选所有级别）" />
                                        </StackPanel>

                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CleanItemViewModel}">
                                                    <Border Margin="{StaticResource SmItemMargin}" Padding="{StaticResource SmItemPadding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- L2 / L3 / 回收站可勾选；L1 随"一键清理"执行，没有勾选框（需求 2.2） -->
                                                            <CheckBox Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}" />

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Style="{StaticResource SmTextBody}">
                                                                    <Run Text="{Binding DisplayName, Mode=OneWay}" /><Run
                                                                        Text="{Binding ActionNote, Mode=OneWay, StringFormat=（{0}）}"
                                                                        Foreground="{DynamicResource DangerBrush}"
                                                                        FontWeight="SemiBold" />
                                                                </TextBlock>
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextCaption}"
                                                                           Text="{Binding SideEffect, Mode=OneWay}" />
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextCaption}"
                                                                           Text="{Binding PathsSample, Mode=OneWay}" />
                                                                <!-- L3 就地显示恢复方式（需求 5.4-4） -->
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextDanger}"
                                                                           Text="{Binding RestoreHint, Mode=OneWay}"
                                                                           Visibility="{Binding RestoreHint, Converter={StaticResource TextToVisibility}}" />
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextCaption}"
                                                                           Text="{Binding KeptText, Mode=OneWay}"
                                                                           Visibility="{Binding HasKept, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmTextCaption}"
                                                                           Text="{Binding Note, Mode=OneWay}"
                                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" MinWidth="120" HorizontalAlignment="Right">
                                                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource SmTextBody}"
                                                                           Text="{Binding SizeText, Mode=OneWay}" />
                                                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource SmTextCaption}"
                                                                           Text="{Binding FileCountText, Mode=OneWay}"
                                                                           Visibility="{Binding FileCount, Converter={StaticResource CountToVisibility}}" />
                                                                <hc:Tag Margin="0,4,0,0" HorizontalAlignment="Right"
                                                                        Content="{Binding RiskText, Mode=OneWay}"
                                                                        Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right"
                                                                           Style="{StaticResource SmTextCaption}"
                                                                           Text="{Binding ActionText, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空态（需求 5.2-4） -->
                    <hc:Card Margin="{StaticResource SmCardMargin}" Padding="{StaticResource SmCardPadding}"
                             Visibility="{Binding HasScanResult, Converter={StaticResource InverseBoolToVisibility}, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SmTextSection}" Text="还没有扫描结果" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextBody}"
                                       Text="点上方「重新扫描」开始盘点 C 盘。扫描只读、可中断，不会移动或删除任何文件。" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                                       Text="清理前请先「导出清单」并人工审阅：导出与执行是两个独立动作，中间不会自动衔接。" />
                        </StackPanel>
                    </hc:Card>

                    <!-- 扫描进行中：可中断（需求 5.2-1） -->
                    <hc:Card Margin="{StaticResource SmCardMargin}" Padding="{StaticResource SmCardPadding}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SmTextBody}"
                                       Text="正在扫描，界面不会冻结；扫描只读，可随时中断。" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                                       Text="{Binding ProgressText, Mode=OneWay}" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding CancelScanCommand}"
                                    Content="中断扫描" />
                        </StackPanel>
                    </hc:Card>
                </StackPanel>
            </hc:ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
