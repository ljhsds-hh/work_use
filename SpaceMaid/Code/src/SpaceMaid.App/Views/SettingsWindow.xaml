<Window x:Class="SpaceMaid.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:helpers="clr-namespace:SpaceMaid.App.Helpers"
        Title="SpaceMaid 设置"
        Width="760" Height="600"
        MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <!--
      设置页（需求 3.4 / 5.1-4）：
      · 隔离区位置（选定即校验，Reject 不允许保存）
      · 保留天数（1–365）
      · 回收站范围（默认只处理系统盘）
      · 立即清空隔离区（二次确认 + 写明不可还原）
      · 报告与日志入口
    -->

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:TextToVisibilityConverter x:Key="TextToVisibility" />
    </Window.Resources>

    <DockPanel Margin="{StaticResource SmPagePadding}">

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="SaveSettingsButton" Command="{Binding SaveCommand}" Content="保存设置"
                    Style="{StaticResource ButtonPrimary}" />
            <Button Name="CloseSettingsButton" Margin="8,0,0,0" Click="OnCloseClick" Content="关闭" />
        </StackPanel>

        <hc:TabControl>

            <!-- ── 隔离区位置 ── -->
            <hc:TabItem Header="隔离区位置">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource SmTextBody}"
                               Text="清理掉的文件不会直接删除，而是先移入隔离区：保留期内可以还原，保留期结束或手动清空后才真正释放。" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                               Text="建议把隔离区放在非系统盘（例如 D 盘）：放在 C 盘时，清理后 C 盘空间不会立刻释放。" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource SmTextSection}" Text="基目录" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <hc:TextBox Grid.Column="0" Name="QuarantinePathBox" IsReadOnly="True"
                                    Text="{Binding QuarantineBasePath, Mode=OneWay}" />
                        <Button Grid.Column="1" Name="PickFolderButton" Margin="8,0,0,0"
                                Command="{Binding PickQuarantineFolderCommand}" Content="选择文件夹…" />
                    </Grid>

                    <TextBlock Margin="0,10,0,0" Style="{StaticResource SmTextCaption}"
                               Text="实际存放位置（本工具只在该目录下建自己的子目录）" />
                    <TextBlock Style="{StaticResource SmTextBody}" Text="{Binding QuarantineStoragePath, Mode=OneWay}" />

                    <hc:Divider Margin="0,14,0,10" />

                    <StackPanel Orientation="Horizontal">
                        <hc:Tag Content="{Binding ValidationLevelText, Mode=OneWay}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SmTextDanger}"
                                   Text="{Binding ValidationMessage, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                               Text="{Binding ValidationDetail, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource SmTextDanger}"
                               Text="当前位置不可用，保存已被拒绝。请换一个本地固定磁盘上的普通文件夹。"
                               Visibility="{Binding IsRejected, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource SmTextCaption}"
                               Text="隔离区当前占用（下次启动会惰性释放到期批次）" />
                    <TextBlock Style="{StaticResource SmTextBody}" Text="{Binding QuarantineUsageText, Mode=OneWay}" />
                </StackPanel>
            </hc:TabItem>

            <!-- ── 保留期与回收站范围 ── -->
            <hc:TabItem Header="保留期与范围">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource SmTextSection}" Text="隔离区保留天数" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                               Text="默认 7 天（1–365）。保留期内文件都可以还原；到期后在下一次启动时自动释放。" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <hc:NumericUpDown Name="RetentionDaysBox" Width="180"
                                          Minimum="1" Maximum="365" Increment="1"
                                          Value="{Binding RetentionDays, Mode=TwoWay}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SmTextCaption}"
                                   Text="{Binding RetentionText, Mode=OneWay}" />
                    </StackPanel>

                    <hc:Divider Margin="0,18,0,12" />

                    <TextBlock Style="{StaticResource SmTextSection}" Text="回收站范围" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <!-- HandyControl 3.5.1 没有独立 Switch 控件，用 hc:ToggleBlock（同一套皮肤语义） -->
                        <hc:ToggleBlock Name="OtherDriveRecycleBinSwitch" Width="58"
                                        IsChecked="{Binding IncludeOtherDriveRecycleBin, Mode=TwoWay}" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SmTextBody}"
                                   Text="把非系统盘的回收站也纳入清单（默认关闭）" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SmTextCaption}"
                               Text="{Binding RecycleBinScopeText, Mode=OneWay}" />

                    <hc:Divider Margin="0,18,0,12" />

                    <TextBlock Style="{StaticResource SmTextSection}" Text="立即清空隔离区" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                               Text="清空后隔离区里的文件会被彻底删除，不再有保留期保护，也无法还原。执行前会再确认一次。" />
                    <Button Name="ClearQuarantineButton" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Command="{Binding ClearQuarantineCommand}" Content="立即清空隔离区…" />
                </StackPanel>
            </hc:TabItem>

            <!-- ── 报告与日志 ── -->
            <hc:TabItem Header="报告与日志">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource SmTextSection}" Text="清单与复核报告目录" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextBody}"
                               Text="{Binding ReportDirectory, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                               Text="每次导出清单会在该目录下建立时间戳子目录（清单.md + 清单.csv），复核报告写在同一目录。" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding OpenReportDirectoryCommand}" Content="打开报告目录" />

                    <hc:Divider Margin="0,18,0,12" />

                    <TextBlock Style="{StaticResource SmTextSection}" Text="日志目录" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextBody}"
                               Text="{Binding LogDirectory, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource SmTextCaption}"
                               Text="全程记录扫描、清理、跳过、还原与异常；启动时惰性清理 30 天前的日志。" />
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding OpenLogDirectoryCommand}" Content="打开日志目录" />
                </StackPanel>
            </hc:TabItem>
        </hc:TabControl>
    </DockPanel>
</Window>
