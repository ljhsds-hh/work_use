<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CodeMemo</RootNamespace>
    <AssemblyName>CodeMemo</AssemblyName>
    <Version>1.0.0</Version>
    <Description>CodeMemo 本地命令速查库：分类收藏 PowerShell / Git 常用命令，支持备注、搜索过滤与一键复制</Description>
    <!-- 单文件独立发布参数（Release 配置生效）：win-x64 免安装单文件 EXE -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 单文件内压缩运行时程序集，体积约减半（少量启动解压开销，可接受） -->
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- 仅保留所需语言资源，减小单文件体积 -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI 组件库：HandyControl（需求强制规范，优先用 HC 控件） -->
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用图标：窗口/任务栏/EXE 共用 -->
    <Resource Include="Assets\app.ico" />
    <!-- 内置命令库种子数据：首次启动导入到用户数据文件，此后以用户文件为准 -->
    <EmbeddedResource Include="Assets\seed\commands.json" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
