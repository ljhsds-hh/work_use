<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DllTool.Core\DllTool.Core.csproj" />
    <ProjectReference Include="..\DllTool.Infrastructure\DllTool.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DllTool.App</AssemblyName>
    <AssemblyTitle>DLL版本替换备份工具</AssemblyTitle>
    <Product>DLL版本替换备份工具</Product>
    <Description>对比新版 DLL 资源与目标目录存量 DLL，完成旧文件安全备份与可控版本覆盖替换的 Windows 桌面工具。</Description>
    <Company>ljhsds-hh</Company>
    <Authors>ljhsds-hh</Authors>
    <Copyright>Copyright (c) 2026 ljhsds-hh</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app_logo.png" />
  </ItemGroup>

</Project>
