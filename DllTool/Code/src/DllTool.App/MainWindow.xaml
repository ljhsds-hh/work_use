<Window x:Class="DllTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="DLL版本替换备份工具"
        Icon="Assets/app.ico"
        Width="1060" Height="920"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 状态胶囊样式 -->
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 结果表格行样式 -->
        <Style x:Key="ResultRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF1F6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- 操作类型胶囊 -->
        <Style x:Key="ActionChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 外观面板：背景设置/清除 + 透明度滑块 -->
        <Style x:Key="AppearancePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#F2F4F9"/>
            <Setter Property="BorderBrush" Value="#E3E7F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="IconActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7"
                                Background="White" BorderBrush="#DFE5F1" BorderThickness="1"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrandSoftBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#C4D0F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
            <Setter Property="Foreground" Value="#C0392B"/>
        </Style>
        <Style x:Key="AppearanceLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 状态→胶囊颜色 转换用的样式映射由模板触发器实现 -->
        <Style x:Key="PillBorderTemplate" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
            <Setter Property="Background" Value="{StaticResource StatusSuccessBgBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StatusDangerBgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="跳过">
                    <Setter Property="Background" Value="{StaticResource StatusSkipBgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBackupOnly}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandSoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillTextTemplate" TargetType="TextBlock" BasedOn="{StaticResource PillTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource StatusDangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultText}" Value="跳过">
                    <Setter Property="Foreground" Value="{StaticResource StatusSkipBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBackupOnly}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 背景图片（可选） -->
        <Image Source="{Binding BackgroundImagePath}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               Opacity="{Binding BackgroundImageOpacity}"
               Visibility="{Binding BackgroundImagePath, Converter={StaticResource StringToVisibilityConverter}}"/>
        <!-- 半透明遮罩，保证内容可读性 -->
        <Border Background="{StaticResource AppBackgroundBrush}" Opacity="{Binding BackgroundOverlayOpacity}"
                Visibility="{Binding BackgroundImagePath, Converter={StaticResource StringToVisibilityConverter}}"/>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ============ 顶部标题栏 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10"
                    Background="{StaticResource BrandGradientBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image Source="Assets/app_logo.png" Width="34" Height="34"
                       Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DLL 版本替换备份工具"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="旧文件安全备份 · 可控版本覆盖 · 全程可审计"
                           FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource AppearancePanelStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="▧ 设置背景" Style="{StaticResource IconActionButtonStyle}"
                            Click="PickBackgroundImage_Click" Margin="0,0,6,0"/>
                    <Button Content="✕ 清除" Style="{StaticResource DangerIconButtonStyle}"
                            Click="ClearBackgroundImage_Click" Margin="0,0,10,0"/>
                    <Rectangle Width="1" Height="18" Fill="#E0E5EE" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="背景强度" Style="{StaticResource AppearanceLabelStyle}"/>
                    <Slider Width="110" Margin="8,0,0,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100"
                            Value="{Binding BackgroundStrength}"
                            IsMoveToPointEnabled="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 模式选择卡片 ============ -->
        <Border Grid.Row="1" Style="{StaticResource AppCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="选择数据源模式" Style="{StaticResource SectionLabelStyle}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" Style="{StaticResource ModeOptionStyle}"
                                 IsChecked="{Binding IsModeA}"
                                 Content="模式A · 实体DLL文件夹"
                                 Tag="比对新版实体 DLL 与目标目录，备份并可选覆盖"/>
                    <RadioButton Grid.Column="2" Style="{StaticResource ModeOptionStyle}"
                                 IsChecked="{Binding IsModeA, Converter={StaticResource InverseBoolConverter}}"
                                 Content="模式B · DLL清单文本文件"
                                 Tag="依据文本清单匹配目标目录，仅备份不覆盖"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ 参数配置 + 结果卡片 ============ -->
        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 模式A：新DLL文件夹（仅模式A显示） -->
                <Border Grid.Row="0" Style="{StaticResource PathRowStyle}" Margin="0,0,0,6"
                        Visibility="{Binding IsModeA, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconChipStyle}">
                            <TextBlock Text="▣" FontSize="15" Foreground="{StaticResource BrandPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="新DLL文件夹" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding NewDllDirectory, TargetNullValue='尚未选择'}"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="浏览…" Style="{StaticResource BrowseButtonStyle}"
                                Click="PickNewDllDirectory_Click"/>
                    </Grid>
                </Border>

                <!-- 模式B：清单文件（仅模式B显示） -->
                <Border Grid.Row="1" Style="{StaticResource PathRowStyle}" Margin="0,0,0,6"
                        Visibility="{Binding IsModeA, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconChipStyle}">
                            <TextBlock Text="≡" FontSize="16" Foreground="{StaticResource BrandPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="DLL清单文件" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding ManifestFile, TargetNullValue='尚未选择'}"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="浏览…" Style="{StaticResource BrowseButtonStyle}"
                                Click="PickManifestFile_Click"/>
                    </Grid>
                </Border>

                <!-- 目标目录 -->
                <Border Grid.Row="2" Style="{StaticResource PathRowStyle}" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconChipStyle}">
                            <TextBlock Text="▸" FontSize="16" Foreground="{StaticResource BrandPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="目标目录" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding TargetDirectory, TargetNullValue='尚未选择'}"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="浏览…" Style="{StaticResource BrowseButtonStyle}"
                                Click="PickTargetDirectory_Click"/>
                    </Grid>
                </Border>

                <!-- 备份根目录 -->
                <Border Grid.Row="3" Style="{StaticResource PathRowStyle}" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconChipStyle}">
                            <TextBlock Text="❏" FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="备份存储根目录" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding ActiveBackupRoot, TargetNullValue='尚未选择'}"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="浏览…" Style="{StaticResource BrowseButtonStyle}"
                                Click="PickBackupRoot_Click"/>
                    </Grid>
                </Border>

                <!-- 执行按钮 + 状态 -->
                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="开始执行" Style="{StaticResource ExecuteButtonStyle}"
                            Command="{Binding ExecuteCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ProgressBar Height="4" Width="180" IsIndeterminate="True"
                                     Foreground="{StaticResource BrandPrimaryBrush}" Background="#E4E8F2"
                                     HorizontalAlignment="Left"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- 结果明细 -->
                <Grid Grid.Row="5" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="操作明细" Style="{StaticResource SectionLabelStyle}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}"
                            Background="{StaticResource StatusSkipBgBrush}"
                            Padding="8,1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ResultRows.Count, StringFormat='{}{0} 条记录'}"
                                   FontSize="11" Foreground="{StaticResource StatusSkipBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- DataGrid -->
                <DataGrid x:Name="ResultGrid" Grid.Row="6"
                          ItemsSource="{Binding ResultRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="46"
                          MinHeight="120"
                          MaxHeight="420"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          BorderBrush="#E9ECF3" BorderThickness="1"
                          Background="White"
                          AlternationCount="2"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F6F8FB"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="BorderBrush" Value="#E9ECF3"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="12,0"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <!-- 选中时用淡蓝底 + 深色文字，避免白字消失 -->
                                    <Setter Property="Background" Value="#E8EEFB"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.AlternatingRowBackground>
                        <SolidColorBrush Color="#FAFBFD"/>
                    </DataGrid.AlternatingRowBackground>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ResultRowStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding StatusBarBrush}"/>
                                            <Border x:Name="RowBg" Grid.Column="1"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <DataGridCellsPresenter/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <!-- 选中行整体淡蓝底，保持状态条与文字可见 -->
                                                <Setter TargetName="RowBg" Property="Background" Value="#E8EEFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件相对路径" Binding="{Binding RelativePath}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="操作类型" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ActionChipStyle}"
                                            Background="{Binding ActionChipBrush}">
                                        <TextBlock Text="{Binding Action}"
                                                   Foreground="{Binding ActionTextBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="结果" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PillBorderTemplate}">
                                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource PillTextTemplate}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="原因 / 备注" Binding="{Binding Reason}" Width="240">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============ 底部路径信息栏 ============ -->
        <Border Grid.Row="3" Background="Transparent" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ActiveBackupDirectory, StringFormat='备份目录：{0}', TargetNullValue='备份目录：未生成'}"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding ActiveManifestPath, StringFormat='备份清单：{0}', TargetNullValue='备份清单：未生成'}"
                           FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
